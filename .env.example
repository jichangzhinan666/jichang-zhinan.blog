# 复制为 .env（本地）或在 Cloudflare Pages 的环境变量中配置；.env 不入库
# IndexNow Key：8–128 位，仅含 a-z A-Z 0-9 与短横线。
# 构建后 scripts/write-indexnow-key.mjs 会把它写入 dist/<KEY>.txt（站点根目录可访问）。
INDEXNOW_KEY=

# 可选：Bing Webmaster Tools 的 <meta name="msvalidate.01"> 内容；留空则不输出该标签
PUBLIC_BING_SITE_VERIFICATION=

# 可选：Google Search Console 的 <meta name="google-site-verification"> 内容；留空则不输出
PUBLIC_GOOGLE_SITE_VERIFICATION=

# 可选：站点联系邮箱；留空时联系页显示“邮箱待配置”，绝不显示虚构邮箱
PUBLIC_CONTACT_EMAIL=
