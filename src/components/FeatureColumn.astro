---
import Icon from './Icon.astro';
import GuidePicks from './GuidePicks.astro';
import { getFeaturedArticles, getPublishedArticles, articleUrl, categoryLabel } from '@/lib/articles';
import { getSpeedReports, getBrand, formatTestedAt } from '@/lib/data';

const featured = await getFeaturedArticles();
const slides = featured.slice(0, 4);
const guides = await getPublishedArticles('guides');
const chooseGuide = guides.find((g) => g.id.endsWith('2026-jichang-xuangou-zhinan')) ?? guides[0];
const ownerReports = getSpeedReports().filter((r) => r.verificationStatus === 'owner-measured');
const latestReport = ownerReports[0];
const latestBrand = latestReport ? getBrand(latestReport.brandId) : undefined;

/** 最新节点测速报告：只取有下载速度数值的记录（站长实测 / 资料文字记录），按时间倒序 */
const latestRows = getSpeedReports()
  .filter((r) => r.testedAt && (r.ownerReport || r.regionResults.some((rr) => rr.downloadMbps !== null)))
  // 每个品牌只取最新一条，按榜单（站长编辑推荐）顺序排列
  .filter((r, i, arr) => arr.findIndex((x) => x.brandId === r.brandId) === i)
  .sort((a, b) => getBrand(a.brandId)!.editorialRank - getBrand(b.brandId)!.editorialRank)
  .slice(0, 4)
  .map((r) => {
    const brand = getBrand(r.brandId)!;
    const rr = r.regionResults.find((x) => x.downloadMbps !== null) ?? r.regionResults[0];
    const own = r.ownerReport;
    return {
      slug: r.slug,
      brand: brand.displayName,
      region: own?.testedNode?.split('（')[0] ?? rr?.region ?? '—',
      latency: own ? `${own.speed.pingMs} ms` : typeof rr?.latencyMs === 'number' ? `${rr.latencyMs} ms` : '—',
      download: own ? `${own.speed.downloadMbps} Mbps` : rr?.downloadMbps !== null && rr?.downloadMbps !== undefined ? `${rr.downloadMbps} Mbps` : '—',
      loss: rr?.packetLossPct !== null && rr?.packetLossPct !== undefined ? `${rr.packetLossPct}%` : '未提供',
      exitOrg: own?.exit ? (own.exit.org ?? own.exit.location) : (r.isp ?? '未标注'),
      exitAsn: own?.exit?.asn ?? '',
      time: formatTestedAt(r).replace('（北京时间）', ''),
    };
  });
// 丢包率全部缺失时不单独占一列（表下说明已注明“资料未提供”），避免表格被挤出卡片
const hasLoss = latestRows.some((r) => r.loss !== '未提供');
---

<div class="feature-col">
  {
    slides.length > 0 ? (
      <section class="feature-carousel card" aria-roledescription="轮播" aria-label="精选教程">
        <div class="carousel-track" id="feature-track">
          {slides.map((a, i) => (
            <article
              class:list={['slide', { active: i === 0 }]}
              role="group"
              aria-roledescription="幻灯片"
              aria-label={`第 ${i + 1} 张，共 ${slides.length} 张`}
              data-index={i}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <a class="slide-link" href={articleUrl(a)} tabindex={i === 0 ? 0 : -1}>
                <span class={`slide-bg cat-${a.data.category}`} aria-hidden="true">
                  <span class="slide-badge">{a.data.category === 'tutorials' ? '新手教程' : categoryLabel(a.data.category)}</span>
                  <span class="slide-art">
                    <span class="slide-window">
                      <span class="slide-dot" />
                      <span class="slide-dot" />
                      <span class="slide-dot" />
                    </span>
                    <Icon name={a.data.category === 'tutorials' ? 'book' : a.data.category === 'guides' ? 'tag' : 'layers'} size={56} />
                  </span>
                </span>
                <span class="slide-text">
                  <strong>{a.data.title}</strong>
                  <small>{a.data.description}</small>
                </span>
              </a>
            </article>
          ))}
        </div>
        {slides.length > 1 && (
          <div class="carousel-controls">
            <button type="button" class="carousel-btn" data-dir="-1" aria-label="上一张">
              <Icon name="chevron" size={18} class="rot-90" />
            </button>
            <div class="carousel-dots" role="tablist" aria-label="选择幻灯片">
              {slides.map((_, i) => (
                <button
                  type="button"
                  role="tab"
                  class:list={['dot', { active: i === 0 }]}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={`第 ${i + 1} 张`}
                  data-index={i}
                />
              ))}
            </div>
            <button type="button" class="carousel-btn" data-dir="1" aria-label="下一张">
              <Icon name="chevron" size={18} class="rot-270" />
            </button>
          </div>
        )}
      </section>
    ) : (
      <section class="card">
        <p class="empty">精选内容整理中</p>
      </section>
    )
  }

  <div class="feature-small">
    {
      chooseGuide && (
        <a class="small-card card card-hover" href={articleUrl(chooseGuide)}>
          <span class="small-cover cat-guides" aria-hidden="true">
            <span class="small-badge">选购指南</span>
            <Icon name="tag" size={30} />
          </span>
          <strong>{chooseGuide.data.title}</strong>
          <small>{chooseGuide.data.description}</small>
        </a>
      )
    }
    <a class="small-card card card-hover" href="/speed-tests/">
      <span class="small-cover cat-speed" aria-hidden="true">
        <span class="small-badge">实测评测</span>
        <Icon name="speed" size={30} />
      </span>
      <strong>节点测速报告总览</strong>
      <small>
        {
          latestReport && latestBrand
            ? `最新：${latestBrand.displayName} · ${latestReport.ownerReport?.testedNode ?? ''}，${formatTestedAt(latestReport)}。共 ${ownerReports.length} 份站长实测报告，均注明工具、出口与时间。`
            : '暂无可验证测速记录。'
        }
      </small>
    </a>
  </div>

  <section class="card latest-speed" aria-labelledby="latest-speed-title">
    <div class="section-head">
      <h2 class="section-title" id="latest-speed-title"><Icon name="speed" size={18} />最新节点测速报告</h2>
      <a class="section-link" href="/speed-tests/">全部报告 →</a>
    </div>
    {
      latestRows.length ? (
        <div class="table-wrap">
          <table class="data speed-mini">
            <thead>
              <tr>
                <th>品牌 · 节点 / 测速时间</th>
                <th class="num">延迟</th>
                <th class="num">下载</th>
                {hasLoss && <th class="num">丢包</th>}
                <th class="exit-head">出口运营商</th>
              </tr>
            </thead>
            <tbody>
              {latestRows.map((row) => (
                <>
                  <tr class="main-row">
                    <td class="nowrap">
                      <a href={`/speed-tests/${row.slug}/`}>{row.brand} · {row.region}</a>
                      <span class="row-time">{row.time}</span>
                    </td>
                    <td class="num nowrap">{row.latency}</td>
                    <td class="num nowrap">{row.download}</td>
                    {hasLoss && <td class="num nowrap">{row.loss}</td>}
                    <td class="exit-cell" title={`${row.exitOrg}${row.exitAsn ? ` · ${row.exitAsn}` : ''}`}>
                      <span class="exit-org">{row.exitOrg}</span>
                      {row.exitAsn && <span class="exit-asn">{row.exitAsn}</span>}
                    </td>
                  </tr>
                  {/* 卡片较窄时“出口运营商”一列放不下：改为显示这一行，上面那一列隐藏（同一份数据，二者只显示其一） */}
                  <tr class="exit-row">
                    <td colspan={hasLoss ? 4 : 3}>
                      <span class="exit-label">出口运营商</span>{row.exitOrg}{row.exitAsn ? ` · ${row.exitAsn}` : ''}
                    </td>
                  </tr>
                </>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty">暂无实测数据</p>
      )}
    <p class="small muted latest-note">延迟为测速工具 Ping；{hasLoss ? '丢包率资料未提供时显示“未提供”' : '现有记录均未提供丢包率，故不单列'}。不同品牌的节点、时段与网络环境不同，不能直接横向比较。</p>
  </section>

  <GuidePicks />
</div>

<style>
  .latest-speed .section-head {
    margin-bottom: 10px;
  }

  /* 测速时间并入首列第二行，表格在三栏布局的中栏里无需横向滚动即可看全 */
  .speed-mini {
    min-width: 0;
    font-size: 0.85rem;
  }

  .speed-mini th,
  .speed-mini td {
    padding: 8px 10px;
    vertical-align: middle;
    white-space: nowrap;
  }

  .row-time {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* 出口运营商名称完整显示：较长的公司名折成两行，不再用省略号截断 */
  .speed-mini td.exit-cell {
    min-width: 124px;
    max-width: 168px;
    white-space: normal;
  }

  .exit-org {
    display: block;
    font-size: 0.8rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .exit-asn {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  /* 按卡片自身宽度切换：四列共需约 472px，放不下时把出口运营商改成每条记录下方的一行，
     不再出现“最后一列被裁掉、要横向滚动才看得到”的情况 */
  .latest-speed {
    container-type: inline-size;
  }

  .speed-mini .exit-row {
    display: none;
  }

  /* 最后一条记录后面还有一行隐藏的 exit-row：表格底边仍由外框负责，不重复画线 */
  .speed-mini tbody tr.main-row:nth-last-child(2) td {
    border-bottom: 0;
  }

  @container (max-width: 473px) {
    .speed-mini .exit-head,
    .speed-mini .exit-cell {
      display: none;
    }

    .speed-mini .exit-row {
      display: table-row;
    }

    .speed-mini th,
    .speed-mini td {
      padding-inline: 8px;
    }

    .speed-mini th:first-child {
      white-space: normal;
    }

    .speed-mini .main-row td {
      padding-bottom: 2px;
      border-bottom: 0;
    }

    .speed-mini .exit-row td {
      padding-top: 0;
      font-size: 0.72rem;
      color: var(--muted);
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .exit-label {
      margin-right: 6px;
    }

    .exit-label::after {
      content: "：";
    }
  }

  .latest-note {
    margin: 10px 0 0;
  }

  .feature-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-carousel {
    padding: 0;
    overflow: hidden;
  }

  .carousel-track {
    position: relative;
  }

  .slide {
    display: none;
  }

  .slide.active {
    display: block;
  }

  .slide-link {
    display: block;
    color: var(--text);
    text-decoration: none;
  }

  .slide-bg {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 8.2;
    background:
      radial-gradient(200px 120px at 80% 20%, rgba(255, 255, 255, 0.25), transparent 70%),
      linear-gradient(135deg, #1d4ed8, #0c2a68);
    color: #fff;
  }

  .slide-bg.cat-guides {
    background:
      radial-gradient(200px 120px at 80% 20%, rgba(255, 255, 255, 0.25), transparent 70%),
      linear-gradient(135deg, #0ea5a4, #0f3b63);
  }

  .slide-bg.cat-wiki {
    background:
      radial-gradient(200px 120px at 80% 20%, rgba(255, 255, 255, 0.25), transparent 70%),
      linear-gradient(135deg, #7c5cff, #1e1b4b);
  }

  .slide-badge,
  .small-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 3px 10px;
    border-radius: 999px;
    /* 深色半透明底，保证白字在浅色渐变起点上也有足够对比度 */
    background: rgba(8, 20, 60, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .slide-art {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 18px 28px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(4px);
  }

  .slide-window {
    display: flex;
    gap: 6px;
    align-self: flex-start;
  }

  .slide-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
  }

  .slide-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
  }

  .slide-text strong {
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .slide-text small {
    font-size: 0.875rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 12px 12px;
  }

  .carousel-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
  }

  .carousel-btn:hover {
    background: var(--primary-50);
    color: var(--primary);
  }

  .rot-90 {
    transform: rotate(90deg);
  }

  .rot-270 {
    transform: rotate(-90deg);
  }

  .carousel-dots {
    display: flex;
    align-items: center;
  }

  /* 按钮本身 28×28 便于触控，圆点用伪元素绘制 */
  .dot {
    position: relative;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .dot::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    /* 未选中的圆点与背景至少 3:1（原浅蓝约 1.6:1，几乎看不出还有几张） */
    background: var(--primary-300);
    background: color-mix(in srgb, var(--primary) 70%, var(--surface));
    transform: translate(-50%, -50%);
    transition: width 0.2s ease, background 0.2s ease;
  }

  .dot:hover::before {
    background: var(--primary);
  }

  .dot.active::before {
    width: 22px;
    background: var(--primary);
  }

  /* 触屏上把圆点的可点区域放大到 36px */
  @media (pointer: coarse) {
    .dot {
      width: 36px;
      height: 36px;
    }
  }

  .feature-small {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .small-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 0 14px;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
  }

  .small-card:hover {
    text-decoration: none;
  }

  .small-card strong {
    padding: 10px 14px 0;
    font-size: 1rem;
    line-height: 1.4;
  }

  .small-card small {
    padding: 0 14px;
    font-size: 0.8125rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .small-cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 7;
    color: #fff;
    background: linear-gradient(135deg, #0ea5a4, #0f3b63);
  }

  .small-cover.cat-speed {
    background:
      radial-gradient(160px 90px at 80% 20%, rgba(255, 255, 255, 0.25), transparent 70%),
      linear-gradient(135deg, #2563eb, #0c2a68);
  }

  @media (max-width: 639px) {
    .feature-small {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const track = document.getElementById('feature-track');
  if (track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-dots .dot'));
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.carousel-btn'));
    let current = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const show = (idx: number) => {
      current = (idx + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle('active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
        s.querySelector('a')?.setAttribute('tabindex', active ? '0' : '-1');
      });
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === current);
        d.setAttribute('aria-selected', i === current ? 'true' : 'false');
      });
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      if (reduced || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 7000);
    };

    btns.forEach((b) =>
      b.addEventListener('click', () => {
        show(current + Number(b.dataset.dir));
        start();
      }),
    );
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.index));
        start();
      }),
    );
    const root = track.closest('.feature-carousel');
    root?.addEventListener('mouseenter', stop);
    root?.addEventListener('mouseleave', start);
    root?.addEventListener('focusin', stop);
    root?.addEventListener('focusout', start);
    start();
  }
</script>
