/**
 * 轻量内联 SVG 图标（原创线性图标，24×24 视口，stroke 风格）
 * 用法：<Icon name="home" size={20} />
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /** 传入 title 时图标对读屏器可见，否则 aria-hidden */
  title?: string;
  strokeWidth?: number;
  /** 父组件传入 class 时 Astro 会附带作用域属性（data-astro-cid-*），需原样转发到 <svg> */
  [key: `data-astro-cid-${string}`]: unknown;
}

// rest 里只有父组件的样式作用域属性：不转发的话，父组件 <style> 中针对该 class 的规则
// （旋转方向、靠右对齐、颜色）全部不会生效
