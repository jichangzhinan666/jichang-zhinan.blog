---
import Icon from './Icon.astro';
import {
  CATEGORY_LABEL,
  PERIOD_LABEL,
  PERIOD_ORDER,
  formatPerGB,
  formatPrice,
  formatTraffic,
  getPlanTiers,
  monthlyEquivalent,
  round3,
} from '@/lib/data';
import type { PlanTier, PricePeriod } from '@/lib/types';

interface Props {
  brandId: string;
  /** 只渲染指定类别 */
  categories?: PlanTier['category'][];
  showSource?: boolean;
}

const { brandId, categories, showSource = true } = Astro.props;
const tiers = getPlanTiers(brandId);
const cats = (categories ?? ['periodic', 'annual-lite', 'one-time', 'dedicated']).filter((c) =>
  tiers.some((t) => t.category === c),
);

function columnsFor(list: PlanTier[]): PricePeriod[] {
  return PERIOD_ORDER.filter((p) => list.some((t) => t.prices[p] !== undefined));
}

function perGB(t: PlanTier): string {
  if (!t.trafficGB) return '—';
  if (t.category === 'one-time') {
    const p = t.prices['one-time'];
    return p !== undefined ? formatPerGB(round3(p / t.trafficGB)) : '—';
  }
  const monthly = t.prices.monthly ?? (t.prices.yearly !== undefined ? monthlyEquivalent(t.prices.yearly, 'yearly') : null);
  if (monthly === null || monthly === undefined) return '—';
  return formatPerGB(round3(monthly / t.trafficGB));
}

function deviceLabel(d: PlanTier['deviceLimit']): string {
  if (d === 'unlimited') return '不限';
  if (typeof d === 'number') return `限 ${d} 台`;
  return '未说明';
}

function couponLabel(c: boolean | null): string {
  if (c === true) return '适用';
  if (c === false) return '不适用';
  return '未说明';
}

const sources = [...new Set(tiers.map((t) => `${t.source.sourceFile}${t.source.sourceLocation ? ` · ${t.source.sourceLocation.split('；')[0]}` : ''}`))];
const verified = [...new Set(tiers.map((t) => t.verifiedAt).filter(Boolean))];
---

{
  tiers.length === 0 ? (
    <p class="empty">暂无已核实套餐资料</p>
  ) : (
    <div class="plan-tables">
      {cats.map((cat) => {
        const list = tiers.filter((t) => t.category === cat);
        const cols = columnsFor(list);
        return (
          <section class="plan-section" aria-labelledby={`plan-${brandId}-${cat}`}>
            <h3 id={`plan-${brandId}-${cat}`} class="plan-title">
              {CATEGORY_LABEL[cat]}
              <span class="muted small">（{list.length} 档）</span>
            </h3>
            <div class="table-wrap">
              <table class="data">
                <thead>
                  <tr>
                    <th>套餐</th>
                    <th>{cat === 'one-time' ? '总流量' : '流量'}</th>
                    {cols.map((p) => (
                      <th class="num">{PERIOD_LABEL[p]}</th>
                    ))}
                    <th class="num">每 GB</th>
                    <th>设备</th>
                    <th>优惠码</th>
                  </tr>
                </thead>
                <tbody>
                  {list.map((t) => (
                    <>
                      <tr class="plan-main">
                        <td>
                          <strong>{t.planName}</strong>
                          {t.features.length > 0 && <div class="plan-features">{t.features.join(' · ')}</div>}
                          {t.note && <div class="plan-note">{t.note}</div>}
                        </td>
                        <td>
                          <span class="nowrap">{formatTraffic(t.trafficGB)}</span>
                          <div class="plan-note">{t.trafficNote}</div>
                        </td>
                        {cols.map((p) => (
                          <td class="num">{t.prices[p] !== undefined ? formatPrice(t.prices[p]!) : '—'}</td>
                        ))}
                        <td class="num">{perGB(t)}</td>
                        <td class="nowrap">{deviceLabel(t.deviceLimit)}</td>
                        <td class="nowrap">{couponLabel(t.couponEligible)}</td>
                      </tr>
                      {/* 窄屏专用：同一份说明文字改为显示在该档下方的整行里（上面单元格内的说明同时隐藏，二者只显示其一） */}
                      {(t.features.length > 0 || t.note || t.trafficNote) && (
                        <tr class="plan-sub">
                          <td colspan={cols.length + 5}>
                            <div class="plan-sub-text">
                              {t.features.length > 0 && <span>{t.features.join(' · ')}</span>}
                              {t.note && <span>{t.note}</span>}
                              {t.trafficNote && <span>{t.trafficNote.startsWith('流量') ? t.trafficNote : `流量：${t.trafficNote}`}</span>}
                            </div>
                          </td>
                        </tr>
                      )}
                    </>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        );
      })}
      {showSource && (
        <p class="plan-source small muted">
          <Icon name="file" size={14} />
          <span>
            每 GB 单价按名义价格计算（周期套餐取月付价，年付小包按年付 ÷ 12），不含优惠码。资料核实日期：{verified.join('、')}；来源：{sources.join('；')}。价格以品牌结算页为准。
          </span>
        </p>
      )}
    </div>
  )
}

<style>
  .plan-tables {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .plan-title {
    margin: 0 0 8px;
    font-size: 1.05rem;
  }

  /* 说明文字给出最小宽度：窄屏时表格横向滚动，而不是把文字压成每行两个字 */
  .plan-features {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 2px;
    min-width: 15em;
    max-width: 30em;
    text-wrap: pretty;
  }

  .plan-note {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 2px;
    min-width: 13em;
    max-width: 32ch;
    text-wrap: pretty;
  }

  /* 按表格所在区块的宽度切换（手机，以及平板 / 小笔记本上较窄的正文栏）：
     说明文字不再挤在“套餐”“流量”两列里，改为每档下方的一整行。
     这一行用 sticky 固定在可视区域内、宽度等于可视宽度，横向滚动看价格时说明始终可读 */
  .plan-section {
    container-type: inline-size;
  }

  .plan-sub {
    display: none;
  }

  /* 最后一档后面还有一行隐藏的 plan-sub：表格底边由外框负责，不重复画线 */
  .plan-main:has(+ .plan-sub:last-child) td {
    border-bottom: 0;
  }

  @container (max-width: 719px) {
    .plan-main .plan-features,
    .plan-main .plan-note {
      display: none;
    }

    .plan-sub {
      display: table-row;
    }

    /* 有说明行的档位：分隔线画在说明行下面 */
    .plan-main:has(+ .plan-sub) td {
      padding-bottom: 4px;
      border-bottom: 0;
    }

    .plan-sub td {
      padding-top: 0;
    }

    .plan-sub-text {
      position: sticky;
      left: 12px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      width: calc(100cqw - 26px);
      max-width: 100%;
      font-size: 0.78rem;
      line-height: 1.55;
      color: var(--muted);
      text-wrap: pretty;
    }
  }

  .plan-source {
    display: flex;
    gap: 6px;
    align-items: flex-start;
    margin: 0;
  }

  .plan-source .icon {
    flex: none;
    margin-top: 3px;
  }
</style>
