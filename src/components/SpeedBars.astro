---
/**
 * 服务端渲染的横向条形图：由可信测速数组驱动，标注单位与日期。
 * 用 HTML + CSS 绘制（不再用固定视口的 SVG），标签、数值在任何宽度下都不会与条形重叠或被裁掉；
 * 容器较窄时标签自动换到条形上方。无数据时显示“暂无可验证测速记录”。
 */
interface Bar {
  label: string;
  sublabel?: string;
  value: number;
  color?: string;
}

interface Props {
  bars: Bar[];
  unit: string;
  title: string;
  caption?: string;
  maxValue?: number;
}

const { bars, unit, title, caption, maxValue } = Astro.props;
const max = maxValue ?? Math.max(1, ...bars.map((b) => b.value));
const fmt = (n: number) => (Number.isInteger(n) ? n.toString() : n.toFixed(2).replace(/\.?0+$/, ''));
---

{
  bars.length === 0 ? (
    <p class="empty">暂无可验证测速记录</p>
  ) : (
    <figure class="speed-bars">
      <ul class="sb-list" aria-label={title}>
        {bars.map((b) => {
          const pct = Math.max(1.5, Math.round((b.value / max) * 1000) / 10);
          return (
            <li class="sb-row">
              <div class="sb-meta">
                <span class="sb-label">{b.label}</span>
                {b.sublabel && <span class="sb-sub">{b.sublabel}</span>}
              </div>
              <div class="sb-bar">
                <div class="sb-track" aria-hidden="true">
                  <span class="sb-fill" style={`width:${pct}%${b.color ? `;background:${b.color}` : ''}`} />
                </div>
                <span class="sb-value">
                  {fmt(b.value)} <small>{unit}</small>
                </span>
              </div>
            </li>
          );
        })}
      </ul>
      {caption && <figcaption class="small muted">{caption}</figcaption>}
    </figure>
  )
}

<style>
  .speed-bars {
    margin: 0;
    container-type: inline-size;
  }

  .sb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sb-row {
    display: grid;
    grid-template-columns: minmax(0, 250px) minmax(0, 1fr);
    gap: 6px 18px;
    align-items: center;
  }

  .sb-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.4;
  }

  .sb-label {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text);
  }

  .sb-sub {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .sb-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .sb-track {
    flex: 1;
    min-width: 0;
    height: 14px;
    border-radius: 999px;
    background: var(--surface-3);
    overflow: hidden;
  }

  .sb-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #60a5fa, var(--primary));
  }

  .sb-value {
    flex: none;
    min-width: 7.2em;
    text-align: right;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .sb-value small {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  figcaption {
    margin-top: 12px;
  }

  @container (max-width: 560px) {
    .sb-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
