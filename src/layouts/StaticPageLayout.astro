---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import { STATIC_PAGES } from '@/lib/site';
import { breadcrumbLd, webPageLd } from '@/lib/seo';

interface Props {
  path: string;
  title: string;
  seoTitle?: string;
  description: string;
  lead?: string;
  extraLd?: Record<string, unknown>[];
}

const { path, title, seoTitle, description, lead, extraLd = [] } = Astro.props;
const lastmod = STATIC_PAGES[path]?.lastmod ?? '2026-11-10';
const crumbs = [
  { name: '首页', href: '/' },
  { name: title, href: path },
];
const jsonLd = [webPageLd(seoTitle ?? title, path, description, lastmod), breadcrumbLd(crumbs), ...extraLd];
---

<BaseLayout title={seoTitle ?? title} description={description} canonicalPath={path} jsonLd={jsonLd} modifiedTime={lastmod}>
  <div class="container container-prose">
    <Breadcrumbs crumbs={crumbs} />
    <header class="page-hero">
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <p class="small muted"><Icon name="calendar" size={14} /> 最后更新：<time datetime={lastmod}>{lastmod}</time></p>
    </header>
    <div class="card static-card">
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 说明类页面用居中的阅读宽度容器（.container-prose），正文卡片占满容器，
     不再靠左留出右侧大片空白 */
  .static-card {
    padding: 28px 32px;
  }

  .static-card .prose {
    max-width: none;
  }

  .page-hero .small {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 639px) {
    .static-card {
      padding: 20px;
    }
  }
</style>
