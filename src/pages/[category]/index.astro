---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Icon from '@/components/Icon.astro';
import TitleText from '@/components/TitleText.astro';
import { CATEGORY_META, STATIC_PAGES, type CategoryKey } from '@/lib/site';
import { getPublishedArticles, articleUrl, articleSlug, categoryLabel, type Article } from '@/lib/articles';
import { getBrands, getEntryPlan, formatPrice } from '@/lib/data';
import { breadcrumbLd, collectionPageLd, itemListLd } from '@/lib/seo';
import glossary from '@/data/glossary.json';
import changelog from '@/data/changelog.json';

export function getStaticPaths() {
  return (Object.keys(CATEGORY_META) as CategoryKey[]).map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props as { category: CategoryKey };
const meta = CATEGORY_META[category];
const articles = await getPublishedArticles(category);
const orderedForBeginners = [...articles].sort((a, b) => a.data.order - b.data.order);
const lastmod = STATIC_PAGES[meta.href]?.lastmod ?? '2026-11-10';
const crumbs = [
  { name: '首页', href: '/' },
  { name: meta.label, href: meta.href },
];

/** 教程栏目的六大分类：只收录已发布的真实文章（按 slug 匹配），不存在的教程不生成链接 */
const TUTORIAL_GROUPS = [
  { id: 'windows', label: 'Windows', icon: 'device', blurb: 'Clash Verge Rev 安装、订阅导入、系统代理与 TUN，以及 Windows 常见问题。', slugs: ['clash-verge-rev-jiaocheng', 'windows-kehuduan-changjian-wenti'] },
  { id: 'macos', label: 'macOS', icon: 'device', blurb: 'Clash Verge Rev 的 macOS 安装包、导入订阅与 TUN 模式说明（与 Windows 共用一篇教程）。', slugs: ['clash-verge-rev-jiaocheng'] },
  { id: 'android', label: 'Android', icon: 'device', blurb: 'Clash Meta for Android、FlClash 的导入步骤、VPN 权限、分应用代理与国产系统后台保活。', slugs: ['android-shiyong-jiaocheng', 'windows-kehuduan-changjian-wenti'] },
  { id: 'ios', label: 'iOS / iPadOS', icon: 'device', blurb: '非大陆地区 Apple ID、Shadowrocket 等客户端导入、VPN 配置权限与只提供官方客户端的品牌怎么用。', slugs: ['ios-shiyong-jiaocheng', 'windows-kehuduan-changjian-wenti'] },
  { id: 'subscription', label: '订阅与节点管理', icon: 'list', blurb: '订阅链接导入与更新、节点切换、规则模式，以及客户端延迟测试与节点测速的记录方法。', slugs: ['clash-verge-rev-jiaocheng', 'jiedian-cesu-fangfa-ipcheck-speedtest'] },
  { id: 'troubleshooting', label: '故障排查', icon: 'tool', blurb: '连不上、订阅失败、部分应用不走代理、系统时间误差、DNS 泄露检测与 Clash 系 DNS 设置。', slugs: ['windows-kehuduan-changjian-wenti', 'dns-xielou-jiance-paicha'] },
] as const;
/** 全站已发布文章按 slug 索引：分类与专题只链接真实存在的文章 */
const allArticles = await getPublishedArticles();
const bySlug = new Map(allArticles.map((a) => [articleSlug(a), a] as const));
const tutorialGroups = TUTORIAL_GROUPS.map((g) => ({ ...g, items: g.slugs.map((s) => bySlug.get(s)).filter((a): a is NonNullable<typeof a> => Boolean(a)) }));

type Ref = { slug: string; focus?: string };
function pick(refs: readonly Ref[]): { article: Article; focus?: string }[] {
  const out: { article: Article; focus?: string }[] = [];
  for (const r of refs) {
    const a = bySlug.get(r.slug);
    if (a) out.push({ article: a, focus: r.focus });
  }
  return out;
}

/** 选购指南的六个专题：决策要点为编辑整理，数字取自品牌与套餐资料；文章只链接已发布的原创文章 */
const brands = getBrands();
const entryPlans = brands.map((b) => getEntryPlan(b.id)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const entryPrices = entryPlans.map((p) => p.price);
const entryTraffic = entryPlans.map((p) => p.trafficGB).filter((n): n is number => typeof n === 'number');
const range = (nums: number[], fmt: (n: number) => string) => (nums.length ? `${fmt(Math.min(...nums))}–${fmt(Math.max(...nums))}` : '资料未提供');
const commonRegions = ['香港', '台湾', '日本', '新加坡', '美国'].filter((r) => brands.every((b) => b.nodeRegions.includes(r)));
const GUIDE_TOPICS = [
  {
    id: 'budget',
    label: '预算选择',
    icon: 'tag',
    question: '每月愿意花多少钱？',
    fact: `本站收录的 ${brands.length} 个品牌，入门档月付为 ${range(entryPrices, formatPrice)}（名义价，不含优惠码）。`,
    points: ['先按每 GB 单价比较，而不是只看月付数字。', '优惠码只对资料注明的档位有效，实付以品牌结算页为准。', '长周期折扣先折算成月付，再评估服务变化的风险。'],
    reads: [
      { slug: 'pianyi-jichang-taocan-bijiao-fangfa', focus: '重点看“每 GB 单价”与“低价背后的隐藏成本”' },
      { slug: 'yuefu-jifu-nianfu-zenme-bijiao', focus: '重点看“折合月付怎么算”与“什么时候年付才合理”' },
      { slug: '2026-jichang-xuangou-zhinan', focus: '重点看“第三步：算每 GB 单价”' },
    ],
    tool: { href: '/compare/', label: '查看套餐价格对比与每 GB 计算器' },
  },
  {
    id: 'traffic',
    label: '流量需求',
    icon: 'speed',
    question: '每月大概用多少 GB？',
    fact: `入门档月流量为 ${range(entryTraffic, (n) => `${n} GB`)}；流量是否每月重置、是否结转，以各品牌资料为准。`,
    points: ['先按用途估算：看视频、用 AI 工具与日常办公的用量差别很大，最好以一个月的实际用量为准。', '用量小可以看年付小包或不限时流量包；用量大就比较每 GB 单价与顶档流量。', '是否限速、是否多设备共享流量等限制，只以品牌资料写明的内容为准。'],
    reads: [
      { slug: '2026-jichang-xuangou-zhinan', focus: '重点看“第二步：估算月流量”' },
      { slug: 'pianyi-jichang-taocan-bijiao-fangfa', focus: '重点看“年付小包”与“不限时流量包”两种方法' },
      { slug: 'yuefu-jifu-nianfu-zenme-bijiao', focus: '重点看“不限时流量包是另一种长周期”' },
    ],
    tool: { href: '/compare/', label: '按月流量筛选套餐' },
  },
  {
    id: 'regions',
    label: '节点地区',
    icon: 'globe',
    question: '常用的服务在哪个地区？',
    fact: commonRegions.length ? `${commonRegions.join('、')}为全部 ${brands.length} 个品牌都覆盖的地区；其他地区以各品牌页为准。` : '各品牌覆盖的地区以品牌页为准。',
    points: ['延迟主要看物理距离，流媒体片库与 AI 服务的可用性看地区政策。', '不要只依赖客户端的“自动选择”，手动试几个地区并记录延迟。', '本站实测只覆盖单节点、单时段，不能当作地区之间或品牌之间的速度比较。'],
    reads: [
      { slug: 'butong-diqu-jiedian-zenme-xuan', focus: '逐个地区说明用途与注意事项' },
      { slug: 'chatgpt-jichang-zenme-xuan', focus: '四个节点访问 ChatGPT、Claude、Gemini 的连通记录' },
      { slug: 'jiedian-di-yanchi-que-sudu-man', focus: '为什么延迟低不等于速度快' },
      { slug: 'wending-jichang-zenme-xuan', focus: '重点看“用真实数据理解这些指标”' },
    ],
    tool: { href: '/speed-tests/', label: '查看节点测速报告' },
  },
  {
    id: 'lines',
    label: '线路类型',
    icon: 'server',
    question: 'IEPL、IPLC、BGP、直连有什么区别？',
    fact: '资料中的线路表述来自各品牌自述，本站未逐一验证；品牌页会原样标注并注明来源。',
    points: ['专线（IEPL / IPLC）、BGP 中转与直连的差别主要在路径与晚高峰表现。', '不要只看名字，要看延迟形态与晚高峰是否衰减。', '月付期内先自测，再决定是否长期付费。'],
    reads: [
      { slug: 'iepl-iplc-bgp-zhilian-quebie', focus: '四种线路的原理、体验差异与验证方法' },
      { slug: 'wending-jichang-zenme-xuan', focus: '重点看“线路类型与稳定的关系”' },
      { slug: 'shenme-shi-jichang-xinshou-bidu', focus: '重点看“线路类型一句话”' },
    ],
    tool: { href: '/reviews/', label: '查看各品牌资料所述的线路类型' },
  },
  {
    id: 'client',
    label: '客户端兼容性',
    icon: 'device',
    question: '你的设备能用吗？',
    fact: '部分品牌只提供官方客户端、不发放订阅链接；第三方客户端的支持情况按品牌资料归类，未核实的标为待核实。',
    points: ['先确认是用官方客户端还是导入订阅链接，这决定了能否使用 Clash 等第三方客户端。', 'iOS 通常需要非大陆地区 Apple ID 或品牌指定的客户端，购买前先确认。', '设备数限制与多设备共享流量的规则，以品牌资料为准。'],
    reads: [
      { slug: 'shenme-shi-jichang-xinshou-bidu', focus: '重点看“两种使用方式：官方客户端还是订阅链接”' },
      { slug: '2026-jichang-xuangou-zhinan', focus: '重点看“第五步：确认使用方式、设备与退款”' },
      { slug: 'clash-verge-rev-jiaocheng', focus: '电脑端导入订阅的实际步骤' },
      { slug: 'ios-shiyong-jiaocheng', focus: 'iPhone / iPad 的客户端与 Apple ID 说明' },
    ],
    tool: { href: '/tutorials/', label: '按设备查看使用教程' },
  },
  {
    id: 'pitfalls',
    label: '购买避坑',
    icon: 'shield',
    question: '下单前要确认什么？',
    fact: '退款、试用与客服政策以品牌资料和结算页为准；资料未写明的内容本站标注“资料未提供”，不应视为承诺。',
    points: ['先月付或最小套餐试用，晚高峰多用几天再考虑长周期。', '只通过官网注册购买；多数品牌资料提醒网上出售的订阅链接并非官方渠道。', '把资料里的流量规则、设备限制与优惠码范围逐条核对一遍再付款。'],
    reads: [
      { slug: 'shenme-shi-jichang-xinshou-bidu', focus: '重点看“新手最常踩的六个坑”' },
      { slug: '2026-jichang-xuangou-zhinan', focus: '重点看“买前验证清单”与“常见误区”' },
      { slug: 'pianyi-jichang-taocan-bijiao-fangfa', focus: '重点看“低价背后的隐藏成本”' },
      { slug: 'yuefu-jifu-nianfu-zenme-bijiao', focus: '重点看“长周期的三种风险”' },
      { slug: 'wending-jichang-zenme-xuan', focus: '重点看“7 天自测表”' },
    ],
    tool: { href: '/methodology/', label: '了解本站的资料核实方法' },
  },
] as const;
const guideTopics = GUIDE_TOPICS.map((t) => ({ ...t, items: pick(t.reads) }));

/** 机场百科的六大分类：术语按名称匹配术语表，文章只链接已发布的真实文章；安装与排错类内容指向使用教程 */
const WIKI_SECTIONS = [
  {
    id: 'basics',
    label: '基础知识',
    icon: 'book',
    blurb: '机场、节点、订阅链接与官方客户端分别是什么，套餐里的倍率、流量重置与不限时流量包怎么理解。',
    terms: ['机场', '节点', '订阅链接', '官方客户端', '倍率', '流量重置', '不限时流量包'],
    reads: [{ slug: 'shenme-shi-jichang-xinshou-bidu', focus: '新手入门：节点、订阅、客户端与套餐表怎么看' }],
    tutorials: [],
  },
  {
    id: 'lines',
    label: '线路架构',
    icon: 'server',
    blurb: 'IEPL / IPLC 专线、BGP 中转与直连在路径、成本与晚高峰表现上的差别，以及用户侧怎么验证服务商的说法。',
    terms: ['IEPL', 'IPLC', 'BGP 中转 / BGP 智能路由', '直连'],
    reads: [
      { slug: 'iepl-iplc-bgp-zhilian-quebie', focus: '四种线路的原理、体验差异与验证方法' },
      { slug: 'wending-jichang-zenme-xuan', focus: '重点看“线路类型与稳定的关系”' },
    ],
    tutorials: [],
  },
  {
    id: 'protocols',
    label: '代理协议',
    icon: 'shield',
    blurb: '客户端与节点之间传输数据的约定：Shadowsocks、VMess / VLESS、Trojan、Hysteria / TUIC 各自的特点与适用环境。',
    terms: ['代理协议', 'Shadowsocks', 'VMess / VLESS', 'Trojan', 'Hysteria / TUIC'],
    reads: [],
    tutorials: [{ slug: 'windows-kehuduan-changjian-wenti', focus: '系统时间误差导致握手失败等连接问题的排查' }],
  },
  {
    id: 'client',
    label: '客户端原理',
    icon: 'device',
    blurb: '系统代理与 TUN 模式决定哪些流量被接管，规则 / 全局 / 直连决定流量去向；官方客户端的“智能分流”对应什么。',
    terms: ['TUN 模式', '系统代理', '规则分流'],
    reads: [{ slug: 'tun-moshi-yu-quanju-daili', focus: '接管方式与去向规则的组合与推荐' }],
    tutorials: [
      { slug: 'clash-verge-rev-jiaocheng', focus: '系统代理与 TUN 的实际开启步骤' },
      { slug: 'android-shiyong-jiaocheng', focus: 'Android 的 VPN 权限与分应用代理' },
    ],
  },
  {
    id: 'dns-ip',
    label: 'DNS 与 IP',
    icon: 'globe',
    blurb: 'DNS 泄露的真正含义、原生 IP 与住宅 IP 的区别，以及 UDP / NAT 类型对游戏与通话的影响。',
    terms: ['DNS 泄露', '原生 IP / 住宅 IP', 'UDP / FullCone NAT'],
    reads: [],
    tutorials: [{ slug: 'dns-xielou-jiance-paicha', focus: 'DNS 泄露的检测站点与 Clash 系 dns 段设置' }],
  },
  {
    id: 'speed',
    label: '测速与解锁',
    icon: 'speed',
    blurb: '延迟、抖动、丢包、满载延迟与晚高峰各测什么，Mbps 与 MB/s 怎么换算，“解锁”为什么会随时变化。',
    terms: ['延迟 / Ping', '抖动', '丢包率', '满载延迟', '晚高峰', 'TLS RTT 与 HTTPS 延迟', 'Mbps 与 MB/s', '解锁'],
    reads: [{ slug: 'jiedian-di-yanchi-que-sudu-man', focus: '延迟低却速度慢的八个原因与排查顺序' }],
    tutorials: [{ slug: 'jiedian-cesu-fangfa-ipcheck-speedtest', focus: '三类测速工具的记录规范与单位换算' }],
  },
] as const;
const termIndex = new Map(glossary.map((g, i) => [g.term, i + 1] as const));
const wikiSections = WIKI_SECTIONS.map((s) => ({
  ...s,
  termLinks: s.terms
    .map((t) => ({ term: t as string, id: termIndex.get(t) }))
    .filter((t): t is { term: string; id: number } => typeof t.id === 'number'),
  items: pick(s.reads),
  tutorialItems: pick(s.tutorials),
}));

const titles: Record<CategoryKey, string> = {
  tutorials: '2026 机场使用教程大全｜Clash 配置、订阅导入与客户端指南',
  guides: '2026 机场选购指南｜预算、流量、节点与线路怎么选？',
  wiki: '2026 机场知识百科｜IEPL/IPLC、BGP、DNS、TUN 与网络代理原理',
  news: '资讯与更新日志：站点动态、内容更新与数据更正记录',
};
const descriptions: Record<CategoryKey, string> = {
  tutorials: `从零学习机场客户端：${articles.length} 篇教程按 Windows、macOS、Android、iOS、订阅与节点管理、故障排查六类整理，覆盖 Clash Verge Rev、Clash Meta、Shadowrocket 的安装与订阅导入、节点切换、规则模式、TUN、DNS 设置与连接故障排查，只写可复现的步骤。`,
  guides: `第一次买机场怎么选：${articles.length} 篇原创指南按预算、流量、节点地区、线路类型、客户端兼容性与购买避坑六个专题整理，用本站 ${brands.length} 个品牌的真实套餐与政策举例，帮你看懂套餐区别、避开常见误区，不含评分。`,
  wiki: `系统整理机场与网络加速的基础知识与技术原理：${glossary.length} 条术语与 ${articles.length} 篇原理文章，按基础知识、线路架构、代理协议、客户端原理、DNS 与 IP、测速与解锁六类归档，解释 IEPL / IPLC、BGP、DNS、TUN、代理协议、原生 IP 与流媒体解锁，不涉及具体品牌评价。`,
  news: `机场指南的站点动态、内容更新与数据更正记录。更新日志逐条列出新增品牌、新增测速报告与修正项，发布日期均为真实日期。`,
};
const jsonLd: Record<string, unknown>[] = [
  collectionPageLd(titles[category], meta.href, descriptions[category]),
  breadcrumbLd(crumbs),
];
if (articles.length) {
  jsonLd.push(itemListLd(meta.label, articles.map((a) => ({ name: a.data.title, url: articleUrl(a), description: a.data.description }))));
}
/** 栏目页自定义的 H1 与导语（未登记的栏目沿用 CATEGORY_META） */
const HERO: Partial<Record<CategoryKey, { title: string; lead: string }>> = {
  tutorials: {
    title: titles.tutorials,
    lead: '从零开始学习机场客户端的安装与使用，涵盖 Windows、Android、iOS、macOS 等设备，提供 Clash Verge Rev、Clash Meta、Shadowrocket 等客户端的配置指南，以及订阅链接导入、节点切换、规则模式、TUN、DNS 设置与连接故障排查教程，帮助新手快速掌握机场服务的使用方法。',
  },
  guides: {
    title: titles.guides,
    lead: '第一次购买机场不知道怎么选择？本指南从预算价格、每月流量、节点地区、线路类型、客户端支持及付费周期出发，分析不同使用场景下的选购要点，帮助你看懂机场套餐区别，避开常见选购误区，找到符合个人需求的网络加速服务。',
  },
  wiki: {
    title: titles.wiki,
    lead: '系统整理机场与网络加速相关的基础知识、专业术语和技术原理，涵盖 IEPL、IPLC、BGP、DNS、TUN、代理协议、节点线路、住宅 IP、原生 IP 及流媒体解锁等常见概念。通过通俗易懂的解释，帮助新手理解机场服务的运行机制、网络线路区别及客户端功能。',
  },
};
const heroTitle = HERO[category]?.title ?? meta.label;
const heroLead = HERO[category]?.lead ?? meta.description;
---

<BaseLayout title={titles[category]} titleSuffix={!HERO[category]} description={descriptions[category]} canonicalPath={meta.href} jsonLd={jsonLd} modifiedTime={lastmod}>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <header class="page-hero">
      <h1><TitleText text={heroTitle} /></h1>
      <p class="lead">{heroLead}</p>
    </header>

    {
      category === 'tutorials' && (
        <>
          <nav class="group-jump small" aria-label="按设备或主题跳转">
            {tutorialGroups.map((g) => (
              <a href={`#tut-${g.id}`}>{g.label}<span class="gj-count">{g.items.length}</span></a>
            ))}
          </nav>
          <section class="card section" aria-labelledby="groups-title">
            <h2 class="section-title" id="groups-title"><Icon name="device" size={20} />按设备与主题找教程</h2>
            <p class="small muted">同一篇教程若同时覆盖多个系统或主题，会在对应分类中重复出现；每个分类只列出已发布的真实文章，暂无文章的主题不会生成链接。</p>
            <div class="group-grid">
              {tutorialGroups.map((g) => (
                <section class="group" id={`tut-${g.id}`} aria-labelledby={`tut-${g.id}-title`}>
                  <h3 id={`tut-${g.id}-title`}><Icon name={g.icon} size={18} />{g.label}<span class="g-count">{g.items.length} 篇</span></h3>
                  <p class="g-blurb">{g.blurb}</p>
                  {g.items.length ? (
                    <ul class="g-list">
                      {g.items.map((a) => (
                        <li>
                          <a href={articleUrl(a)}>{a.data.title}</a>
                          <span class="small muted">{a.data.description}</span>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="small muted">该分类暂无已发布教程。</p>
                  )}
                  <p class="g-more small">
                    其他分类：{tutorialGroups.filter((o) => o.id !== g.id).map((o, i) => <>{i > 0 && ' · '}<a href={`#tut-${o.id}`}>{o.label}</a></>)}
                  </p>
                </section>
              ))}
            </div>
          </section>
        </>
      )
    }

    {
      category === 'guides' && (
        <>
          <nav class="group-jump small" aria-label="按选购专题跳转">
            {guideTopics.map((t) => (
              <a href={`#topic-${t.id}`}>{t.label}<span class="gj-count">{t.items.length}</span></a>
            ))}
          </nav>
          <section class="card section" aria-labelledby="topics-title">
            <h2 class="section-title" id="topics-title"><Icon name="tag" size={20} />六个选购专题</h2>
            <p class="small muted">每个专题先给出决策要点，再链接到本站已发布的原创文章；数字取自品牌与套餐资料，性能、退款与套餐限制中未经核实的内容不作为确定事实。排行榜与套餐数据不在此重复，请使用对应页面。</p>
            <div class="group-grid topic-grid">
              {guideTopics.map((t) => (
                <section class="group topic" id={`topic-${t.id}`} aria-labelledby={`topic-${t.id}-title`}>
                  <h3 id={`topic-${t.id}-title`}><Icon name={t.icon} size={18} />{t.label}</h3>
                  <p class="g-q">{t.question}</p>
                  <p class="g-fact small">{t.fact}</p>
                  <ul class="g-points">
                    {t.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                  {t.items.length ? (
                    <>
                      <p class="g-sub">延伸阅读</p>
                      <ul class="g-list">
                        {t.items.map((it) => (
                          <li>
                            <a href={articleUrl(it.article)}>
                              {it.article.data.title}
                              {it.article.data.category !== 'guides' && <span class="g-cat">{categoryLabel(it.article.data.category)}</span>}
                            </a>
                            {it.focus && <span class="small muted">{it.focus}</span>}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <p class="small muted">该专题暂无已发布文章。</p>
                  )}
                  <p class="g-more small">
                    <a href={t.tool.href}>{t.tool.label} →</a>
                  </p>
                </section>
              ))}
            </div>
          </section>
        </>
      )
    }

    {
      category === 'guides' && orderedForBeginners.length > 0 && (
        <section class="card section" aria-labelledby="path-title">
          <h2 class="section-title" id="path-title"><Icon name="plane" size={20} />新手建议阅读顺序</h2>
          <ol class="path">
            {orderedForBeginners.map((a) => (
              <li>
                <a href={articleUrl(a)}>{a.data.title}</a>
                <span class="small muted">{a.data.description}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      category === 'wiki' && (
        <>
          <nav class="group-jump small" aria-label="按知识分类跳转">
            {wikiSections.map((s) => (
              <a href={`#wiki-${s.id}`}>{s.label}<span class="gj-count">{s.items.length + s.termLinks.length}</span></a>
            ))}
          </nav>
          <section class="card section" aria-labelledby="wiki-cats-title">
            <h2 class="section-title" id="wiki-cats-title"><Icon name="layers" size={20} />六大知识分类</h2>
            <p class="small muted">每个分类列出本站已发布的原理文章与对应术语；安装步骤与故障排查不在百科展开，统一指向使用教程栏目。暂无专文的分类只提供术语解释，不生成空白链接。</p>
            <div class="group-grid topic-grid">
              {wikiSections.map((s) => (
                <section class="group topic" id={`wiki-${s.id}`} aria-labelledby={`wiki-${s.id}-title`}>
                  <h3 id={`wiki-${s.id}-title`}><Icon name={s.icon} size={18} />{s.label}</h3>
                  <p class="g-blurb">{s.blurb}</p>
                  {s.items.length ? (
                    <>
                      <p class="g-sub">原理文章</p>
                      <ul class="g-list">
                        {s.items.map((it) => (
                          <li>
                            <a href={articleUrl(it.article)}>
                              {it.article.data.title}
                              {it.article.data.category !== 'wiki' && <span class="g-cat">{categoryLabel(it.article.data.category)}</span>}
                            </a>
                            {it.focus && <span class="small muted">{it.focus}</span>}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <p class="small muted">该分类暂无专文，先看下方术语解释。</p>
                  )}
                  {s.termLinks.length > 0 && (
                    <>
                      <p class="g-sub">术语解释（{s.termLinks.length} 条）</p>
                      <ul class="g-terms">
                        {s.termLinks.map((t) => (
                          <li>
                            <a href={`#term-${t.id}`}>{t.term}</a>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                  {s.tutorialItems.length > 0 && (
                    <p class="g-more small">
                      操作与排错见教程：
                      {s.tutorialItems.map((it, i) => (
                        <>
                          {i > 0 && ' · '}
                          <a href={articleUrl(it.article)} title={it.article.data.title}>
                            {it.focus ?? it.article.data.title}
                          </a>
                        </>
                      ))}
                    </p>
                  )}
                </section>
              ))}
            </div>
          </section>
        </>
      )
    }

    <section class="card section" aria-labelledby="list-title">
      <h2 class="section-title" id="list-title"><Icon name="file" size={20} />全部文章（{articles.length}）</h2>
      {articles.length ? <div class="article-list">{articles.map((a) => <ArticleCard article={a} showCategory={false} />)}</div> : <p class="empty">该栏目暂无已发布文章</p>}
    </section>

    {
      category === 'wiki' && (
        <section class="card section" id="glossary" aria-labelledby="glossary-title">
          <h2 class="section-title" id="glossary-title"><Icon name="layers" size={20} />术语表（{glossary.length} 条）</h2>
          <p class="small muted">按主题排列，可用页内搜索（Ctrl / ⌘ + F）快速定位。定义为通用解释，不涉及具体品牌的表现。</p>
          <dl class="glossary">
            {glossary.map((g, i) => (
              <div class="gl-item" id={`term-${i + 1}`}>
                <dt>
                  <a href={`#term-${i + 1}`} class="gl-anchor" aria-label={`${g.term} 的链接`}>#</a>
                  {g.term}
                  {g.en && <span class="gl-en">{g.en}</span>}
                </dt>
                <dd>{g.definition}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      category === 'news' && (
        <section class="card section" id="changelog" aria-labelledby="changelog-title">
          <h2 class="section-title" id="changelog-title"><Icon name="edit" size={20} />更新日志</h2>
          <p class="small muted">只记录真实发生的变更；日期为变更发生日，不随构建自动改动。</p>
          {changelog.map((entry) => (
            <article class="cl-entry">
              <h3><time datetime={entry.date}>{entry.date}</time></h3>
              <ul>
                {entry.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </article>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
