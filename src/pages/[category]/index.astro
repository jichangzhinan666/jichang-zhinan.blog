    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* “#” 锚点是可点击的链接，颜色需达到可读对比度（原来的浅蓝只有约 1.5:1） */
  .gl-anchor {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
  }

  .gl-anchor:hover {
    color: var(--primary);
