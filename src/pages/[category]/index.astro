    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .g-q {
    margin: -2px 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--primary);
  }

  .g-fact {
    margin: 0;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
