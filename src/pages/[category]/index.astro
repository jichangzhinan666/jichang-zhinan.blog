    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    text-decoration: none;
  }

  .group-jump a:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .gj-count {
    font-size: 0.72rem;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--primary-50);
    color: var(--primary);
  }

  .group-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface-2);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .group:target {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-100);
  }

  .group h3 {
    margin: 0;
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .g-count {
    margin-left: auto;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  .g-blurb {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-2);
  }

  .g-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .g-list li {
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
