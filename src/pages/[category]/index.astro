---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Icon from '@/components/Icon.astro';
import { CATEGORY_META, STATIC_PAGES, type CategoryKey } from '@/lib/site';
import { getPublishedArticles, articleUrl } from '@/lib/articles';
import { breadcrumbLd, collectionPageLd, itemListLd } from '@/lib/seo';
import glossary from '@/data/glossary.json';
import changelog from '@/data/changelog.json';

export function getStaticPaths() {
  return (Object.keys(CATEGORY_META) as CategoryKey[]).map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props as { category: CategoryKey };
const meta = CATEGORY_META[category];
const articles = await getPublishedArticles(category);
const orderedForBeginners = [...articles].sort((a, b) => a.data.order - b.data.order);
const lastmod = STATIC_PAGES[meta.href]?.lastmod ?? '2026-11-10';
const crumbs = [
  { name: '首页', href: '/' },
  { name: meta.label, href: meta.href },
];

const titles: Record<CategoryKey, string> = {
  tutorials: '机场使用教程：Clash Verge Rev、iOS、Android、Windows 客户端与排错',
  guides: '机场选购指南 2027：新手入门、稳定性、价格与付费周期怎么选',
  wiki: '机场百科：IEPL / IPLC / BGP、TUN、DNS 泄露等术语与原理',
  news: '资讯与更新日志：站点动态、内容更新与数据更正记录',
};
const descriptions: Record<CategoryKey, string> = {
  tutorials: `${articles.length} 篇客户端教程：Clash Verge Rev 安装与订阅导入、iOS 与 Android 常见客户端、Windows 常见问题、TUN 模式与系统代理、DNS 泄露排查、节点测速与记录规范。只写可复现的步骤，不含任何品牌的虚构评价。`,
  guides: `${articles.length} 篇选购指南：什么是机场、2027 机场怎么选、稳定机场的判断方法（延迟、丢包、晚高峰）、便宜套餐的比较方法、不同地区节点的用途、月付/季付/年付怎么比。结论均可在站内资料库中核对。`,
  wiki: `${glossary.length} 条术语解释与 ${articles.length} 篇原理文章：机场、节点、订阅链接、IEPL / IPLC / BGP / 直连、倍率、原生 IP、TUN 模式、DNS 泄露、晚高峰、TLS RTT、Mbps 与 MB/s 等。`,
  news: `机场指南的站点动态、内容更新与数据更正记录。更新日志逐条列出新增品牌、新增测速报告与修正项，发布日期均为真实日期。`,
};
const jsonLd: Record<string, unknown>[] = [
  collectionPageLd(titles[category], meta.href, descriptions[category]),
  breadcrumbLd(crumbs),
];
if (articles.length) {
  jsonLd.push(itemListLd(meta.label, articles.map((a) => ({ name: a.data.title, url: articleUrl(a), description: a.data.description }))));
}
---

<BaseLayout title={titles[category]} description={descriptions[category]} canonicalPath={meta.href} jsonLd={jsonLd} modifiedTime={lastmod}>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <header class="page-hero">
      <h1>{meta.label}</h1>
      <p class="lead">{meta.description}</p>
    </header>

    {
      category === 'guides' && orderedForBeginners.length > 0 && (
        <section class="card section" aria-labelledby="path-title">
          <h2 class="section-title" id="path-title"><Icon name="plane" size={20} />新手建议阅读顺序</h2>
          <ol class="path">
            {orderedForBeginners.map((a) => (
              <li>
                <a href={articleUrl(a)}>{a.data.title}</a>
                <span class="small muted">{a.data.description}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="card section" aria-labelledby="list-title">
      <h2 class="section-title" id="list-title"><Icon name="file" size={20} />全部文章（{articles.length}）</h2>
      {articles.length ? <div class="article-list">{articles.map((a) => <ArticleCard article={a} showCategory={false} />)}</div> : <p class="empty">该栏目暂无已发布文章</p>}
    </section>

    {
      category === 'wiki' && (
        <section class="card section" id="glossary" aria-labelledby="glossary-title">
          <h2 class="section-title" id="glossary-title"><Icon name="layers" size={20} />术语表（{glossary.length} 条）</h2>
          <p class="small muted">按主题排列，可用页内搜索（Ctrl / ⌘ + F）快速定位。定义为通用解释，不涉及具体品牌的表现。</p>
          <dl class="glossary">
            {glossary.map((g, i) => (
              <div class="gl-item" id={`term-${i + 1}`}>
                <dt>
                  <a href={`#term-${i + 1}`} class="gl-anchor" aria-label={`${g.term} 的链接`}>#</a>
                  {g.term}
                  {g.en && <span class="gl-en">{g.en}</span>}
                </dt>
                <dd>{g.definition}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      category === 'news' && (
        <section class="card section" id="changelog" aria-labelledby="changelog-title">
          <h2 class="section-title" id="changelog-title"><Icon name="edit" size={20} />更新日志</h2>
          <p class="small muted">只记录真实发生的变更；日期为变更发生日，不随构建自动改动。</p>
          {changelog.map((entry) => (
            <article class="cl-entry">
              <h3><time datetime={entry.date}>{entry.date}</time></h3>
              <ul>
                {entry.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </article>
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .path {
    margin: 0;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .path li a {
    font-weight: 600;
  }

  .path li span {
    display: block;
  }

  .article-list {
    display: flex;
    flex-direction: column;
  }

  .glossary {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .gl-item {
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  .gl-item:target {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-100);
  }

  .gl-item dt {
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .gl-anchor {
    color: var(--primary-200);
    text-decoration: none;
    font-weight: 500;
  }

  .gl-anchor:hover {
    color: var(--primary);
  }

  .gl-en {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 500;
  }

  .gl-item dd {
    margin: 6px 0 0;
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .cl-entry {
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }

  .cl-entry h3 {
    font-size: 1rem;
    color: var(--primary);
  }

  .cl-entry ul {
    margin: 0;
    font-size: 0.925rem;
  }

  @media (max-width: 767px) {
    .glossary {
      grid-template-columns: 1fr;
    }
  }
</style>
