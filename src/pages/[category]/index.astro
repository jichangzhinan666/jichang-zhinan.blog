    color: var(--text-2);
  }

  .cl-entry {
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }

  .cl-entry h3 {
    font-size: 1rem;
    color: var(--primary);
  }

  .cl-entry ul {
    margin: 0;
    font-size: 0.925rem;
  }

  @media (max-width: 767px) {
    .glossary {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
