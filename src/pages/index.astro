---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import QuickLinks from '@/components/QuickLinks.astro';
import RankList from '@/components/RankList.astro';
import FeatureColumn from '@/components/FeatureColumn.astro';
import Sidebar from '@/components/Sidebar.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import BrandMark from '@/components/BrandMark.astro';
import EvidenceBadge from '@/components/EvidenceBadge.astro';
import SpeedBars from '@/components/SpeedBars.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import { SITE, CATEGORY_META } from '@/lib/site';
import { getPublishedArticles } from '@/lib/articles';
import {
  computeRanking,
  getBrands,
  getEntryPlan,
  getSpeedReports,
  getBrand,
  formatPrice,
  formatTraffic,
  formatPerGB,
  formatTestedAt,
  getStats,
} from '@/lib/data';
import { faqLd, itemListLd, webPageLd } from '@/lib/seo';

// 最新 8 篇，并保证每个栏目至少出现 1 篇，避免栏目 Tab 出现“暂无文章”
const allArticles = await getPublishedArticles();
const articles = allArticles.slice(0, 8);
for (const key of Object.keys(CATEGORY_META) as (keyof typeof CATEGORY_META)[]) {
  if (!articles.some((a) => a.data.category === key)) {
    const newest = allArticles.find((a) => a.data.category === key);
    if (newest) articles.push(newest);
  }
}
const ranking = computeRanking();
const brands = getBrands();
const stats = getStats();

// 测速概览：只取有 Mbps 数值的记录（站长实测 + 文字记录）
const reports = getSpeedReports();
const speedRows = reports
  .flatMap((r) =>
    r.regionResults
      .filter((rr) => rr.downloadMbps !== null)
      .map((rr) => ({ report: r, rr, brand: getBrand(r.brandId)! })),
  )
  .slice(0, 8);

const ownerBars = reports
  .filter((r) => r.ownerReport)
  .map((r) => ({
    label: `${getBrand(r.brandId)!.displayName} · ${r.ownerReport!.testedNode?.split('（')[0] ?? ''}`,
    sublabel: `${formatTestedAt(r)} · ${r.ownerReport!.testServer ?? ''}`,
    value: r.ownerReport!.speed.downloadMbps,
  }));

const faq = [
  {
    q: '这份 2027 机场推荐榜单是怎么排出来的？会不会有评分？',
    a: '榜单是“站长编辑推荐榜”，不是性能评分。名次由站长综合资料完整度、套餐性价比、线路与客户端政策后指定，每个名次旁都标出可核查的事实：测速证据等级、入门价格与地区数。本站不显示任何 9.x 这类分数，推荐榜与实测数据分开呈现，详见“测评、排序与测速方法”页面。',
  },
  {
    q: '页面上的价格和优惠码可靠吗？',
    a: '全部价格、流量、优惠码均来自品牌或推广方提供的资料，并注明资料核实日期；实付金额以各品牌结算页为准。若发现资料与官网不一致，请通过联系页反馈，我们会在核实后更正并记录在更新日志。',
  },
  {
    q: '测速数据是在哪里、用什么工具测的？',
    a: '2026-11-10 的四份报告为站长使用 IPCheck.ing（Cloudflare 测速与连通性测试）配合品牌客户端“测试延迟”完成，报告注明出口节点、服务器与北京时间，但未标注本地接入运营商；其余为用户提供的 MiaoKo / SpeedCentre 截图或文字记录。每份报告都列出了局限，不同品牌的数据不能直接横向比较。',
  },
  {
    q: '为什么有些品牌写着“暂无测速证据”？',
    a: '大佬云、暮光加速的资料中“晚高峰实测”标注为“待观察实测中”，本站没有任何可核实的测速记录，所以如实标注，并在榜单中排在有证据的品牌之后。补充实测后会更新。',
  },
  {
    q: '本站和这些机场是什么关系？',
    a: '本站是信息整理型博客，不销售任何服务。品牌入口为推广链接，用户经由链接购买时本站可能获得佣金；排序规则与评语不受佣金影响，详见“推广关系披露”。',
  },
  {
    q: '新手应该从哪里开始？',
    a: '建议先读“什么是机场”和“2027 机场选购指南”，再根据设备阅读 Clash Verge Rev、iOS 或 Android 教程。8 个收录品牌中多数以官方客户端为主，部分不提供订阅链接，选购前请先确认自己的使用方式。',
  },
];

const jsonLd = [
  webPageLd(SITE.tagline, '/', SITE.description, '2026-11-10'),
  itemListLd(
    '2027 机场推荐榜单（编辑整理榜 · 前瞻版）',
    ranking.map((r) => ({
      name: r.brand.displayName,
      url: `/reviews/${r.brand.slug}/`,
      description: r.brand.tagline,
    })),
    '站长编辑推荐顺序，不含评分；每个品牌附测速证据等级、入门价格与地区数。',
  ),
  faqLd(faq),
];

const homeTitle = `${SITE.name}｜${SITE.tagline}`;
---

<BaseLayout title={homeTitle} titleSuffix={false} description={SITE.description} canonicalPath="/" jsonLd={jsonLd}>
  <div class="container">
    <Hero />
    <QuickLinks />

    <section class="home-main" aria-label="榜单、精选与工具">
      <section class="card col-rank" aria-labelledby="home-rank-title">
        <div class="section-head">
          <h2 class="section-title" id="home-rank-title">
            <Icon name="trophy" size={20} />
            2027 机场推荐排行榜
          </h2>
          <a class="section-link" href="/rankings/2027/">查看完整榜单 →</a>
        </div>
        <RankList limit={5} compact />
        <p class="rank-foot small muted">
          站长编辑推荐榜 · 前瞻版。名次为编辑推荐，不是性能评分；证据标签、价格与地区均来自资料。<a href="/methodology/">查看榜单说明</a>
        </p>
      </section>

      <div class="col-feature">
        <FeatureColumn />
      </div>

      <div class="col-side">
        <Sidebar />
      </div>
    </section>

    <section class="card section" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 class="section-title" id="latest-title">
          <Icon name="file" size={20} />
          最新文章
        </h2>
        <div class="tabs" role="tablist" aria-label="按栏目筛选文章">
          <button type="button" role="tab" class="tab active" aria-selected="true" data-filter="all">全部</button>
          {
            (Object.keys(CATEGORY_META) as (keyof typeof CATEGORY_META)[]).map((k) => (
              <button type="button" role="tab" class="tab" aria-selected="false" data-filter={k}>
                {CATEGORY_META[k].label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="article-list" id="latest-list">
        {articles.map((a) => <ArticleCard article={a} />)}
      </div>
      <p class="empty tab-empty" hidden>该栏目暂无已发布文章</p>
      <div class="more-row">
        <a class="btn btn-outline" href="/tutorials/">全部教程</a>
        <a class="btn btn-outline" href="/guides/">全部指南</a>
        <a class="btn btn-outline" href="/wiki/">机场百科</a>
        <a class="btn btn-outline" href="/news/">资讯与更新</a>
      </div>
    </section>

    <section class="card section" aria-labelledby="library-title">
      <div class="section-head">
        <h2 class="section-title" id="library-title">
          <Icon name="layers" size={20} />
          品牌资料库
        </h2>
        <a class="section-link" href="/reviews/">按地区、价格、功能筛选 →</a>
      </div>
      <p class="muted small">
        已收录 {stats.brands} 个品牌、{stats.tiers} 档套餐（{stats.plans} 条价格记录）。每个品牌页列出资料来源、核实时间、套餐、节点、客户端政策与测速证据。
      </p>
      <ul class="brand-grid">
        {
          brands.map((b) => {
            const entry = getEntryPlan(b.id);
            return (
              <li class="brand-card">
                <a href={`/reviews/${b.slug}/`} class="brand-card-link">
                  <BrandMark brand={b} size={44} />
                  <span class="brand-card-body">
                    <strong>{b.displayName}</strong>
                    <small>{b.tagline}</small>
                    <span class="brand-card-meta">
                      {entry ? (
                        <span class="brand-price">
                          {formatPrice(entry.price)}/月 · {formatTraffic(entry.trafficGB)} · {formatPerGB(entry.pricePerGB)}
                        </span>
                      ) : (
                        <span class="muted">入门价格待核实</span>
                      )}
                      <span class="muted">{b.nodeRegions.length} 个地区</span>
                    </span>
                    <EvidenceBadge brand={b} />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class="card section" aria-labelledby="speed-title">
      <div class="section-head">
        <h2 class="section-title" id="speed-title">
          <Icon name="speed" size={20} />
          节点测速概览
        </h2>
        <a class="section-link" href="/speed-tests/">全部测速报告 →</a>
      </div>
      <div class="speed-grid">
        <div>
          <SpeedBars
            bars={ownerBars}
            unit="Mbps"
            title="站长实测下载速度（IPCheck.ing，2026-11-10）"
            caption="四次测试分别连接不同品牌的不同地区节点与测速服务器，时段也不同，不能当作品牌之间的性能对比；本地接入运营商未标注。"
          />
        </div>
        <div class="table-wrap">
          <table class="data">
            <caption class="visually-hidden">有下载速度数值的测速记录</caption>
            <thead>
              <tr>
                <th>品牌 / 节点</th>
                <th>测试时间</th>
                <th class="num">下载</th>
                <th class="num">上传</th>
                <th class="num">延迟</th>
                <th class="num">抖动</th>
                <th>来源</th>
              </tr>
            </thead>
            <tbody>
              {
                speedRows.map(({ report, rr, brand }) => (
                  <tr>
                    <td>
                      <a href={`/speed-tests/${report.slug}/`}>
                        {brand.displayName} · {report.ownerReport?.testedNode?.split('（')[0] ?? rr.region}
                      </a>
                    </td>
                    <td class="nowrap">{formatTestedAt(report)}</td>
                    <td class="num">{rr.downloadMbps} Mbps</td>
                    <td class="num">{rr.uploadMbps !== null ? `${rr.uploadMbps} Mbps` : '—'}</td>
                    <td class="num">{report.ownerReport ? `${report.ownerReport.speed.pingMs} ms` : typeof rr.latencyMs === 'number' ? `${rr.latencyMs} ms` : '—'}</td>
                    <td class="num">{report.ownerReport ? `${report.ownerReport.speed.jitterMs} ms` : rr.jitterMs !== null ? `${rr.jitterMs} ms` : '—'}</td>
                    <td class="small">{report.verificationStatus === 'owner-measured' ? '站长实测' : '资料文字记录'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
      <p class="small muted" style="margin-top:12px">
        表中延迟为测速工具的 Ping / 资料记录值；丢包率资料未提供，故不显示。截图类记录（MiaoKo / SpeedCentre）单位为 MB/s，见各报告页。
      </p>
    </section>

    <FAQ items={faq} title="常见问题" id="home-faq" />
  </div>
</BaseLayout>

<style>
  .home-main {
    display: grid;
    grid-template-columns: minmax(0, 35fr) minmax(0, 40fr) minmax(0, 25fr);
    gap: 20px;
    margin-top: 20px;
  }

  .col-rank {
    align-self: start;
  }

  .rank-foot {
    margin: 12px 0 0;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tab {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .tab:hover {
    background: var(--primary-50);
    color: var(--primary);
  }

  .tab.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  .article-list {
    display: flex;
    flex-direction: column;
  }

  .more-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  .brand-grid {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .brand-card-link {
    display: flex;
    gap: 12px;
    height: 100%;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .brand-card-link:hover {
    border-color: var(--primary-200);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .brand-card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .brand-card-body strong {
    font-size: 1rem;
  }

  .brand-card-body small {
    font-size: 0.8rem;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .brand-card-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.78rem;
    margin: 4px 0;
  }

  .brand-price {
    color: var(--primary);
    font-weight: 600;
  }

  .speed-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 1199px) {
    .home-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .col-side {
      grid-column: 1 / -1;
    }

    .brand-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .speed-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .home-main {
      grid-template-columns: 1fr;
    }

    .col-side {
      grid-column: auto;
    }

    .brand-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tabs .tab'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#latest-list .article-card'));
  const empty = document.querySelector<HTMLElement>('.tab-empty');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter ?? 'all';
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      let visible = 0;
      cards.forEach((c) => {
        const show = filter === 'all' || c.dataset.category === filter;
        c.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>
