---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RankCards from '@/components/RankCards.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import TitleText from '@/components/TitleText.astro';
import { SITE } from '@/lib/site';
import { computeRanking, getEntryPlan, getTopPlan, getReportsForBrand, formatPrice, formatTraffic, formatPerGB, getStats } from '@/lib/data';
import { getRankingContentUpdatedAt } from '@/lib/lastmod';
import { articleLd, breadcrumbLd, faqLd, itemListLd } from '@/lib/seo';

const ranking = computeRanking();
// 品牌数、套餐档数、实测份数全部由数据文件统计；新增品牌、套餐或测速报告后页面上的数字自动变化
const stats = getStats();
// 榜单内容最近一次实质更新的日期：页面文案、品牌资料核实、套餐核实、测速报告四类日期中最晚的一个（见 src/lib/lastmod.ts）
const lastmod = getRankingContentUpdatedAt();

/* ---- 由数据派生的实测与记录清单（按编辑推荐顺序）：页面里不写死份数、日期与品牌名 ---- */
const reportsInOrder = ranking.flatMap((r) => getReportsForBrand(r.brand.id).map((report) => ({ brand: r.brand, report })));
const ownerTests = reportsInOrder.filter((x) => x.report.verificationStatus === 'owner-measured');
const thirdPartyRecords = reportsInOrder.filter((x) => x.report.verificationStatus !== 'owner-measured');
const range = (values: string[], joiner: string) => {
  const sorted = [...new Set(values)].sort();
  return sorted.length === 0 ? '' : sorted.length === 1 ? sorted[0] : `${sorted[0]}${joiner}${sorted.at(-1)}`;
};
// testedAt 形如 2026-11-10T11:43:00+08:00，资料均为北京时间，直接取字符串里的日期与时分
const ownerDates = ownerTests.map((x) => x.report.testedAt?.slice(0, 10)).filter((d): d is string => !!d);
const ownerDateText = range(ownerDates, ' 至 ');
const ownerTimes = ownerTests.filter((x) => x.report.testedAtPrecision === 'datetime' && x.report.testedAt).map((x) => x.report.testedAt!.slice(11, 16));
const ownerTimeText = new Set(ownerDates).size === 1 && ownerTimes.length === ownerTests.length ? range(ownerTimes, '–') : '';
const ownerTools = [...new Set(ownerTests.map((x) => x.report.tool.split(/[（(+]/)[0].trim()))].join('、');
const nodeLabel = (node: string | null | undefined) => (node ?? '').replace(/（.*?）/g, '').replace(/节点$/, '').trim();
const ownerTestsPerBrand = new Map<string, number>();
for (const x of ownerTests) ownerTestsPerBrand.set(x.brand.id, (ownerTestsPerBrand.get(x.brand.id) ?? 0) + 1);
const oneOwnerTestEach = ownerTestsPerBrand.size > 0 && [...ownerTestsPerBrand.values()].every((n) => n === 1);
const verifiedRange = range(
  ranking.map((r) => r.brand.lastVerifiedAt).filter((d): d is string => !!d),
  ' 至 ',
);
const recordLabel = (x: (typeof thirdPartyRecords)[number]) => {
  const r = x.report;
  const kind = r.verificationStatus === 'user-supplied-record' ? '文字记录' : '截图';
  const tool = r.tool.startsWith('资料未注明') ? null : r.tool.split(/[（( ]/)[0];
  const isp = r.isp ? r.isp.split('（')[0] : null;
  return `${x.brand.displayName} ${r.testedAt ? r.testedAt.slice(0, 10) : '未标注日期'}（${[kind, tool, isp].filter(Boolean).join('，')}）`;
};

const cheapest = [...ranking].filter((r) => r.entry).sort((a, b) => a.entry!.price - b.entry!.price)[0];
const bestPerGB = [...ranking].filter((r) => r.pricePerGB !== null).sort((a, b) => a.pricePerGB! - b.pricePerGB!)[0];
const biggest = ranking
  .map((r) => ({ r, top: getTopPlan(r.brand.id) }))
  .filter((x) => x.top)
  .sort((a, b) => (b.top!.trafficGB ?? 0) - (a.top!.trafficGB ?? 0))[0];
const mostRegions = [...ranking].sort((a, b) => b.regionCount - a.regionCount)[0];
const thirdParty = ranking.filter((r) => /支持导入|可导入/.test(r.brand.clientPolicy.thirdPartyClients) && !/不支持/.test(r.brand.clientPolicy.thirdPartyClients));
const officialOnly = ranking.filter((r) => /不对外发放|不提供|暂不支持/.test(r.brand.clientPolicy.subscriptionLink));
const withEvidence = ranking.filter((r) => r.brand.speedTests.evidenceStatus === 'owner-report');

const faq = [
  {
    q: '这个榜单的名次代表速度快慢吗？',
    a: `不代表。名次是站长的编辑推荐顺序，不是速度测试结果。现有的 ${ownerTests.length} 份站长实测连接的是不同品牌的不同节点，测速服务器与时段也各不相同，不能用来比较品牌速度。要看速度，请进入各品牌页的测速报告并注意其局限说明。`,
  },
  {
    q: '“2026 年度版”的数据范围是什么？',
    a: `本站于 ${SITE.launchedAt} 上线，资料整理与站长实测均发生在 2026 年 11 月，本页会在同一 URL 下持续更新数据与说明；2027 年榜单将使用 /rankings/2027/，不会覆盖本页。`,
  },
  {
    q: '“编辑推荐”“推广合作”“实测排名”有什么区别？',
    a: '本页是“编辑推荐榜”：名次由站长综合资料完整度、套餐性价比、线路与客户端政策后指定，不含分数。页面中的品牌入口都是推广链接（推广合作），这一点在披露页说明；每个名次旁的证据等级、价格与地区都是可核查的资料事实。本站目前没有“实测排名”，因为现有实测的网络环境与节点不统一，不满足横向排名的前提。',
  },
  {
    q: '为什么没有收录更多品牌？',
    a: `目前只收录了提供了完整资料（套餐、节点、客户端政策）的 ${stats.brands} 个品牌。新增品牌需要同样格式的资料与可核实的信息，模板见“关于”页面。`,
  },
];

const crumbs = [
  { name: '首页', href: '/' },
  { name: '机场推荐', href: '/rankings/' },
  { name: '2026 机场推荐榜单', href: '/rankings/2026/' },
];
// 页面年份取 SITE.rankingYear（当前为 2026 年度版）；地址与 canonical 固定为 /rankings/2026/，不随品牌数量或文案变化
const h1 = `${SITE.rankingYear} 机场推荐排行榜`;
const subtitle = ['机场评测', '套餐价格对比', '线路与节点实测'];
const intro = '持续收录热门机场品牌，系统整理套餐价格、入门流量、覆盖地区、线路类型、节点测速、流媒体及 AI 服务兼容性等信息，为用户提供清晰透明的机场推荐与比较指南。';
// 独立的 SEO 标题（不走全站“｜机场指南”后缀）
const title = `${h1}｜套餐价格对比与节点实测 - ${SITE.name}`;
const description = '机场指南持续整理机场推荐排行榜、品牌评测、套餐价格、节点测速与线路分析，提供可核实的服务资料和实测报告，帮助用户比较不同机场的价格、功能与使用体验。';
const jsonLd = [
  articleLd({
    type: 'Article',
    headline: h1,
    description,
    url: '/rankings/2026/',
    datePublished: '2026-11-10',
    dateModified: lastmod,
    keywords: ['2026 机场推荐', '机场排行榜', '机场推荐榜单', 'IEPL 机场', 'IPLC 机场'],
    section: '机场推荐',
  }),
  breadcrumbLd(crumbs),
  itemListLd(
    '2026 机场推荐榜单（编辑整理榜）',
    ranking.map((r) => ({ name: r.brand.displayName, url: `/reviews/${r.brand.slug}/`, description: r.brand.tagline })),
    '站长编辑推荐顺序；不含评分，每个品牌附可核查的资料事实。',
  ),
  faqLd(faq),
];
---

<BaseLayout title={title} titleSuffix={false} description={description} jsonLd={jsonLd} ogType="article" publishedTime="2026-11-10" modifiedTime={lastmod}>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <header class="rank-hero">
      <div class="rh-body">
        <span class="pill pill-dark rh-eyebrow"><Icon name="trophy" size={14} />站长编辑推荐榜 · 非测速排名</span>
        <h1><TitleText text={h1} /></h1>
        {/* 副标题只在“·”之后折行，各段文字不拆开 */}
        <p class="rh-sub">
          {subtitle.map((part, i) => (
            <>
              {i > 0 && ' '}
              <span class="nowrap">{i < subtitle.length - 1 ? `${part} ·` : part}</span>
            </>
          ))}
        </p>
        <p class="rh-intro">{intro}</p>
        <dl class="rh-stats">
          <div class="rh-stat">
            <dt><Icon name="layers" size={15} class="rh-stat-icon" />已收录品牌</dt>
            <dd><strong>{stats.brands}</strong> 个</dd>
          </div>
          <div class="rh-stat">
            <dt><Icon name="tag" size={15} class="rh-stat-icon" />已整理套餐</dt>
            <dd><strong>{stats.tiers}</strong> 档</dd>
          </div>
          <div class="rh-stat">
            <dt><Icon name="speed" size={15} class="rh-stat-icon" />已发布实测</dt>
            {/* 与页面下方“数据时间范围”里的清单同一来源：榜单内品牌的、站长完成并已发布的实测报告 */}
            <dd><strong>{ownerTests.length}</strong> 份</dd>
          </div>
          <div class="rh-stat">
            <dt><Icon name="calendar" size={15} class="rh-stat-icon" />内容更新</dt>
            <dd><time datetime={lastmod} data-page-updated>{lastmod}</time></dd>
          </div>
        </dl>
        <p class="rh-byline">
          由<a href={SITE.author.url} rel="author">{SITE.author.name}</a>编辑整理。名次为编辑推荐，价格与节点来自品牌资料，实测只统计站长完成并有报告的测试。
        </p>
        <details class="method">
          <summary>
            <Icon name="info" size={16} class="method-icon" />
            <span class="method-title">评选方法与资料来源</span>
            <span class="method-hint method-hint-open">点击展开</span>
            <span class="method-hint method-hint-close">点击收起</span>
            <Icon name="chevron" size={16} class="method-chev" />
          </summary>
          <ol class="small">
            <li><strong>名次是编辑评价：</strong>由站长综合资料完整度、套餐性价比、线路类型与客户端政策后指定，属于<strong>站长编辑推荐</strong>，不是算法评分，也不是实测排名；名次不代表速度或稳定性。</li>
            <li><strong>价格与节点来自品牌资料：</strong>价格、流量、地区、线路均来自各品牌/推广方提供的资料（核实日期见品牌页），本站不自行推算或补全；价格以结算页为准。</li>
            <li>
              <strong>实测单独标注：</strong>测速证据分三类——<strong>有本站实测</strong>（{ownerTests.length > 0 ? `站长${ownerDateText ? ` ${ownerDateText} ` : ''}使用 ${ownerTools} 完成，报告注明出口与时间` : '目前暂无'}）、<strong>有第三方记录</strong>（资料方文字记录或用户提供的 MiaoKo / SpeedCentre 截图，含未标注日期者）、<strong>暂无测速证据</strong>。只有第一类才算“已实测”；现有实测的网络环境、节点与时段不统一，不能横向比较。
            </li>
            <li><strong>推广关系：</strong>品牌入口为推广链接，购买可能为本站带来佣金；名次不因佣金调整，不接受付费排名。详见<a href="/disclosure/">推广关系披露</a>与<a href="/methodology/">方法说明</a>。</li>
          </ol>
        </details>
      </div>
    </header>

    <section class="card section" aria-label="完整榜单">
      <RankCards />
    </section>

    <section class="card section" aria-labelledby="scenario-title">
      <h2 class="section-title" id="scenario-title"><Icon name="tag" size={20} />按使用场景怎么看这份榜单</h2>
      <p class="small muted">以下结论全部由套餐表与客户端政策直接推出，不涉及速度判断。</p>
      <div class="scenario-grid">
        {
          cheapest && (
            <div class="scenario">
              <h3>预算优先：入门月付最低</h3>
              <p>
                <a href={`/reviews/${cheapest.brand.slug}/`}>{cheapest.brand.displayName}</a> {cheapest.entry!.planName}：{formatPrice(cheapest.entry!.price)}/月，{formatTraffic(cheapest.entry!.trafficGB)}。
              </p>
            </div>
          )
        }
        {
          bestPerGB && (
            <div class="scenario">
              <h3>按流量算最便宜：入门档每 GB 单价最低</h3>
              <p>
                <a href={`/reviews/${bestPerGB.brand.slug}/`}>{bestPerGB.brand.displayName}</a> {bestPerGB.entry!.planName}：{formatPerGB(bestPerGB.pricePerGB)}（{formatPrice(bestPerGB.entry!.price)}/月，{formatTraffic(bestPerGB.entry!.trafficGB)}）。
              </p>
            </div>
          )
        }
        {
          biggest && (
            <div class="scenario">
              <h3>大流量：单档月流量最高</h3>
              <p>
                <a href={`/reviews/${biggest.r.brand.slug}/`}>{biggest.r.brand.displayName}</a> {biggest.top!.planName}：{formatTraffic(biggest.top!.trafficGB)}/月，月付 {biggest.top!.prices.monthly !== undefined ? formatPrice(biggest.top!.prices.monthly) : '—'}。
              </p>
            </div>
          )
        }
        {
          mostRegions && (
            <div class="scenario">
              <h3>多地区出口：资料列出的地区最多</h3>
              <p>
                <a href={`/reviews/${mostRegions.brand.slug}/`}>{mostRegions.brand.displayName}</a>：{mostRegions.regionCount} 个地区（{mostRegions.brand.nodeRegions.slice(0, 8).join('、')}{mostRegions.brand.nodeRegions.length > 8 ? ' 等' : ''}）。
              </p>
            </div>
          )
        }
        <div class="scenario">
          <h3>要用 Clash 等第三方客户端</h3>
          <p>
            资料写明可导入第三方客户端：{thirdParty.length ? thirdParty.map((r, i) => <>{i > 0 && '、'}<a href={`/reviews/${r.brand.slug}/`}>{r.brand.displayName}</a></>) : '暂无'}。其中灵动云需向客服申请订阅链接，隐形人需通过客服确认兼容情况。
          </p>
        </div>
        <div class="scenario">
          <h3>只想用官方客户端、不折腾</h3>
          <p>
            明确不发放/不提供订阅链接的品牌：{officialOnly.length ? officialOnly.map((r, i) => <>{i > 0 && '、'}<a href={`/reviews/${r.brand.slug}/`}>{r.brand.displayName}</a></>) : '暂无'}。这类品牌无法导入 Clash，请先确认自己的设备在支持列表内。
          </p>
        </div>
        <div class="scenario">
          <h3>想看有实测报告的</h3>
          <p>
            {
              withEvidence.length > 0 ? (
                <>
                  目前有站长实测报告{ownerDateText && `（${ownerDateText}）`}的品牌：{withEvidence.map((r, i) => <>{i > 0 && '、'}<a href={`/reviews/${r.brand.slug}/`}>{r.brand.displayName}</a></>)}{oneOwnerTestEach && '，各一份'}，均为单次单节点测试。
                </>
              ) : (
                '目前还没有站长实测报告。'
              )
            }
          </p>
        </div>
      </div>
    </section>

    <section class="card section" aria-labelledby="table-title">
      <h2 class="section-title" id="table-title"><Icon name="compare" size={20} />关键参数速查表</h2>
      <div class="table-wrap">
        <table class="data quick-table">
          <thead>
            <tr>
              <th class="num">#</th>
              <th>品牌</th>
              <th>入门档</th>
              <th class="num">月付</th>
              <th class="num">月流量</th>
              <th class="num">每 GB</th>
              <th class="num">地区</th>
              <th>线路</th>
              <th>第三方客户端</th>
              <th>测速证据</th>
            </tr>
          </thead>
          <tbody>
            {
              ranking.map((r) => {
                const e = getEntryPlan(r.brand.id);
                const tp = r.brand.clientPolicy.thirdPartyClients;
                const client = /待核实/.test(tp) ? '第三方待核实' : /支持导入|可导入/.test(tp) && !/不支持/.test(tp) ? (/客服/.test(tp) ? '可导入（需客服确认）' : '可导入 Clash') : /不支持/.test(tp) ? '不支持导入' : /不推荐/.test(tp) ? '不推荐导入' : '资料未提供';
                const line = [...new Set(r.brand.lineTypes.map((l) => l.replace(/^[^：]+：/, '')))].join(' / ');
                const ev = r.reasons.find((x) => x.startsWith('证据等级：'))?.replace('证据等级：', '') ?? '—';
                return (
                  <tr>
                    <td class="num">{r.position}</td>
                    <td><a href={`/reviews/${r.brand.slug}/`}>{r.brand.displayName}</a></td>
                    <td>{e?.planName ?? '—'}</td>
                    <td class="num">{e ? formatPrice(e.price) : '—'}</td>
                    <td class="num">{e ? formatTraffic(e.trafficGB) : '—'}</td>
                    <td class="num">{e ? formatPerGB(e.pricePerGB) : '—'}</td>
                    <td class="num">{r.regionCount} 个</td>
                    <td class="qt-line" title={r.brand.lineTypes.join('；')}>{line}</td>
                    <td>{client}</td>
                    <td>{ev}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:10px">价格均为资料中的名义价格（人民币），不含优惠码；资料核实日期见各品牌页。想比较全部档位请用<a href="/compare/">套餐对比</a>。</p>
    </section>

    <section class="card section" aria-labelledby="preview-title">
      <h2 class="section-title" id="preview-title"><Icon name="calendar" size={20} />关于“2026 年度版”的数据时间范围</h2>
      <ul class="small">
        <li>品牌资料整理日期：{verifiedRange || '资料未提供'}；套餐价格以品牌结算页实时显示为准。</li>
        <li>
          {
            ownerTests.length > 0 ? (
              <>
                站长实测：{ownerDateText}{ownerTimeText && ` ${ownerTimeText}（北京时间）`}，共 {ownerTests.length} 份单节点报告（{ownerTests.map((x, i) => <>{i > 0 && '、'}<a href={`/speed-tests/${x.report.slug}/`}>{x.brand.displayName} {nodeLabel(x.report.ownerReport?.testedNode)}</a></>)}）。
              </>
            ) : (
              '站长实测：目前暂无。'
            )
          }
        </li>
        {
          thirdPartyRecords.length > 0 && (
            <li>
              他人提供的记录（非本站实测）：共 {thirdPartyRecords.length} 份——{thirdPartyRecords.map((x, i) => <>{i > 0 && '；'}<a href={`/speed-tests/${x.report.slug}/`}>{recordLabel(x)}</a></>)}。
            </li>
          )
        }
        <li>本页在同一 URL 持续更新，每次变化记录在<a href="/news/#changelog">更新日志</a>；2027 年榜单另建 /rankings/2027/。</li>
      </ul>
    </section>

    <FAQ items={faq} title="关于榜单的常见问题" id="rank-faq" />
  </div>
</BaseLayout>

<style>
  /* ---------- 页首：深蓝底，与首页首屏同一组色值 ---------- */
  .rank-hero {
    position: relative;
    margin-top: 12px;
    padding: 40px 48px 36px;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(900px 400px at 88% 0%, rgba(59, 130, 246, 0.42), transparent 60%),
      radial-gradient(600px 300px at 0% 100%, rgba(14, 165, 233, 0.26), transparent 60%),
      linear-gradient(135deg, var(--hero-from), var(--hero-to));
    color: var(--hero-text);
    /* clip 不会形成可滚动容器（与首页首屏同样的处理） */
    overflow: hidden;
    overflow: clip;
    box-shadow: var(--shadow-lg);
  }

  /* 右上角一层很淡的网格底纹，纯装饰 */
  .rank-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(147, 197, 253, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(147, 197, 253, 0.1) 1px, transparent 1px);
    background-size: 36px 36px;
    -webkit-mask-image: radial-gradient(ellipse 70% 95% at 100% 0%, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse 70% 95% at 100% 0%, #000 0%, transparent 72%);
    pointer-events: none;
  }

  .rh-body {
    position: relative;
    container-type: inline-size;
