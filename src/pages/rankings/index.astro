---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BrandMark from '@/components/BrandMark.astro';
import Icon from '@/components/Icon.astro';
import { STATIC_PAGES } from '@/lib/site';
import { topicLists, formatPrice, formatTraffic, formatPerGB, getStats } from '@/lib/data';
import { breadcrumbLd, collectionPageLd, itemListLd } from '@/lib/seo';

const lists = topicLists();
const stats = getStats();
const lastmod = STATIC_PAGES['/rankings/'].lastmod;
const crumbs = [
  { name: '首页', href: '/' },
  { name: '机场推荐', href: '/rankings/' },
];
const title = '2026 机场分类榜单｜低价机场、大流量套餐与节点地区指南';
const description = `精选 2026 年机场分类榜单与专题对比，覆盖低价机场套餐、大流量方案、节点覆盖地区和线路类型。依据收录的 ${stats.brands} 个品牌套餐价格、流量及地区资料分类整理，帮助读者根据预算和使用需求快速筛选合适的机场服务，不含评分。`;
const jsonLd = [
  collectionPageLd(title, '/rankings/', description),
  breadcrumbLd(crumbs),
  itemListLd('入门月付最低榜（周期套餐）', lists.byEntryPrice.map((x) => ({ name: `${x.brand.displayName} ${x.entry.planName}`, url: `/reviews/${x.brand.slug}/`, description: `${formatPrice(x.entry.price)}/月 · ${formatTraffic(x.entry.trafficGB)}` }))),
];
---

<BaseLayout title={title} titleSuffix={false} description={description} jsonLd={jsonLd}>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <header class="page-hero">
      <h1>{title}</h1>
      <p class="lead">精选 2026 年机场分类榜单与专题对比，覆盖低价机场套餐、大流量方案、节点覆盖地区和线路类型。依据收录的套餐价格、流量及地区资料分类整理，帮助读者根据预算和使用需求快速筛选合适的机场服务。</p>
      <p class="lead lead-note"><strong>榜单说明：</strong>年度总榜采用站长编辑推荐顺序，专题榜根据套餐数据分类展示，均不代表实际测速性能排名。资料持续更新（最近更新 {lastmod}），具体价格与服务以品牌实际结算页面为准。</p>
    </header>

    <section class="card section annual" aria-labelledby="annual-title">
      <div class="annual-text">
        <span class="pill"><Icon name="trophy" size={14} />年度榜</span>
        <h2 id="annual-title">2026 机场推荐榜单（年度版）</h2>
        <p>{stats.brands} 个品牌、{stats.tiers} 档套餐；名次为站长编辑推荐顺序，不含评分，每个名次附证据等级、入门价与地区数。</p>
        <a class="btn btn-primary" href="/rankings/2026/">查看 2026 榜单 <Icon name="arrow-right" size={16} /></a>
      </div>
      <ul class="annual-list small">
        <li>2027 年榜单将使用 /rankings/2027/，2026 榜单 URL 保持不变。</li>
        <li>排序方法与局限见 <a href="/methodology/">测评、排序与测速方法</a>。</li>
        <li>想横向比较全部档位，请用 <a href="/compare/">套餐对比</a>。</li>
      </ul>
    </section>

    <div class="topic-grid">
      <section class="card topic" aria-labelledby="t1">
        <h2 id="t1"><Icon name="tag" size={18} />入门月付最低榜</h2>
        <p class="small muted">各品牌月付最低的周期套餐，按月付价升序。</p>
        <ol>
          {lists.byEntryPrice.map((x) => (
            <li>
              <a href={`/reviews/${x.brand.slug}/`}><BrandMark brand={x.brand} size={28} />{x.brand.displayName}</a>
              <span>{x.entry.planName} · <strong>{formatPrice(x.entry.price)}</strong>/月 · {formatTraffic(x.entry.trafficGB)}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="card topic" aria-labelledby="t2">
        <h2 id="t2"><Icon name="compare" size={18} />入门档每 GB 单价最低榜</h2>
        <p class="small muted">月付价 ÷ 月流量，不含优惠码。</p>
        <ol>
          {lists.byPerGB.map((x) => (
            <li>
              <a href={`/reviews/${x.brand.slug}/`}><BrandMark brand={x.brand} size={28} />{x.brand.displayName}</a>
              <span><strong>{formatPerGB(x.entry.pricePerGB)}</strong> · {x.entry.planName}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="card topic" aria-labelledby="t3">
        <h2 id="t3"><Icon name="download" size={18} />单档月流量最高榜</h2>
        <p class="small muted">各品牌月流量最大的周期套餐。</p>
        <ol>
          {lists.byTopTraffic.map((x) => (
            <li>
              <a href={`/reviews/${x.brand.slug}/`}><BrandMark brand={x.brand} size={28} />{x.brand.displayName}</a>
              <span>{x.top.planName} · <strong>{formatTraffic(x.top.trafficGB)}</strong>/月{x.top.prices.monthly !== undefined ? ` · ${formatPrice(x.top.prices.monthly)}/月` : ''}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="card topic" aria-labelledby="t4">
        <h2 id="t4"><Icon name="globe" size={18} />节点地区最多榜</h2>
        <p class="small muted">按资料列出的地区数量；节点数以资料为准。</p>
        <ol>
          {lists.byRegions.map((b) => (
            <li>
              <a href={`/reviews/${b.slug}/`}><BrandMark brand={b} size={28} />{b.displayName}</a>
              <span><strong>{b.nodeRegions.length}</strong> 个地区{b.nodeCount ? ` · ${b.nodeCount} 节点` : ''}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="card topic" aria-labelledby="t5">
        <h2 id="t5"><Icon name="calendar" size={18} />年付小包价格榜</h2>
        <p class="small muted">每月定额流量的年付套餐，按年付价升序。</p>
        <ol>
          {lists.annualLite.map((x) => (
            <li>
              <a href={`/reviews/${x.brand.slug}/`}><BrandMark brand={x.brand} size={28} />{x.brand.displayName}</a>
              <span>{x.tier.planName} · <strong>{formatPrice(x.tier.prices.yearly!)}</strong>/年 · {formatTraffic(x.tier.trafficGB)}/月</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="card topic topic-note" aria-labelledby="t6">
        <h2 id="t6"><Icon name="info" size={18} />为什么没有“速度榜”</h2>
        <p class="small">现有实测分别连接不同品牌的不同节点，测速服务器、时段与本地网络环境都不统一，不满足横向排名的前提。待在同一网络环境、同一时段对多个品牌完成重复测试后，才会发布实测排名，方法见<a href="/methodology/">方法说明</a>。</p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-hero .lead + .lead {
    margin-top: 8px;
  }
  .page-hero .lead-note {
    font-size: 0.95rem;
    color: var(--text-3, var(--text-2));
  }
  .annual {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    background:
      radial-gradient(500px 200px at 90% 0%, rgba(59, 130, 246, 0.18), transparent 70%),
      var(--surface);
  }

  .annual-text .pill {
    margin-bottom: 10px;
  }

  .annual-list {
    margin: 0;
    padding-left: 1.2em;
    color: var(--text-2);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .topic h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  .topic h2 .icon {
    color: var(--primary);
  }

  .topic ol {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: topic;
  }

  .topic li {
    counter-increment: topic;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.925rem;
  }

  .topic li::before {
    content: counter(topic);
    font-weight: 700;
    color: var(--muted);
  }

  .topic li:last-child {
    border-bottom: 0;
  }

  .topic li a {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 600;
  }

  .topic li span {
    text-align: right;
    color: var(--text-2);
    font-size: 0.875rem;
  }

  @media (max-width: 1023px) {
    .annual {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .topic li {
      grid-template-columns: 24px minmax(0, 1fr);
    }

    .topic li span {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
