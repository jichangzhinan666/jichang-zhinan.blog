---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BrandMark from '@/components/BrandMark.astro';
import EvidenceBadge from '@/components/EvidenceBadge.astro';
import PlanTable from '@/components/PlanTable.astro';
import ReportCard from '@/components/ReportCard.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import FavButton from '@/components/FavButton.astro';
import ReadTracker from '@/components/ReadTracker.astro';
import {
  computeRanking,
  getBrands,
  getEntryPlan,
  getReportsForBrand,
  getSourcesForBrand,
  formatPrice,
  formatTraffic,
  formatPerGB,
  EVIDENCE_LABEL,
} from '@/lib/data';
import { resolveEvidenceImage } from '@/lib/evidence';
import { articleLd, breadcrumbLd, faqLd } from '@/lib/seo';

export async function getStaticPaths() {
  return getBrands().map((b) => ({ params: { slug: b.slug }, props: { brandId: b.id } }));
}

const { brandId } = Astro.props as { brandId: string };
const ranking = computeRanking();
const ranked = ranking.find((r) => r.brand.id === brandId)!;
const brand = ranked.brand;
const entry = getEntryPlan(brand.id);
const reports = getReportsForBrand(brand.id);
const sources = getSourcesForBrand(brand.id);
const ownerReport = reports.find((r) => r.verificationStatus === 'owner-measured');
const reportImage = ownerReport ? resolveEvidenceImage(ownerReport.evidenceFiles[0]?.file ?? '') : null;

const idx = ranking.findIndex((r) => r.brand.id === brandId);
const prev = ranking[(idx - 1 + ranking.length) % ranking.length].brand;
const next = ranking[(idx + 1) % ranking.length].brand;

const tested = brand.speedTests.evidenceStatus !== 'none';
const evidenceText = EVIDENCE_LABEL[brand.speedTests.evidenceStatus];

const title = `${brand.displayName}机场怎么样？套餐价格、优惠码与实测证据（2026 版）`;
const descParts = [
  `${brand.displayName}${brand.englishName ? `（${brand.englishName}）` : ''}资料整理：${brand.nodeRegions.length} 个地区${brand.nodeCount ? ` ${brand.nodeCount} 个节点` : ''}，${brand.lineTypes[0] ?? ''}`,
  entry ? `入门 ${formatPrice(entry.price)}/月 ${formatTraffic(entry.trafficGB)}` : '',
  brand.coupon ? `优惠码 ${brand.coupon.code}${brand.coupon.discount ? `（${brand.coupon.discount}）` : ''}` : '',
  tested ? `${evidenceText}${brand.speedTests.latestDatedTest ? ` ${brand.speedTests.latestDatedTest}` : ''}` : '暂无测速证据',
  `资料核实 ${brand.lastVerifiedAt}，价格以结算页为准。`,
].filter(Boolean);
const description = descParts.join('；').replace('；资料核实', '。资料核实');

const faq = [
  {
    q: `${brand.displayName}支持哪些客户端？能导入 Clash 吗？`,
    a: `资料显示${brand.displayName}${brand.clientPolicy.officialClient ? '以官方客户端为主要使用方式，' : ''}订阅链接政策为“${brand.clientPolicy.subscriptionLink}”，第三方客户端政策为“${brand.clientPolicy.thirdPartyClients}”。${brand.supportedPlatforms.length ? `资料列出的支持系统：${brand.supportedPlatforms.join('、')}。` : '资料未逐一列出支持系统。'}`,
  },
  {
    q: `${brand.displayName}有优惠码吗？怎么用？`,
    a: brand.coupon
      ? `资料提供的优惠码为 ${brand.coupon.code}${brand.coupon.discount ? `，折扣 ${brand.coupon.discount}` : '，折扣幅度资料未注明'}。${brand.coupon.appliesTo.length ? `适用：${brand.coupon.appliesTo.join('、')}。` : ''}${brand.coupon.excludes.length ? `不适用：${brand.coupon.excludes.join('、')}。` : ''}${brand.coupon.limits.length ? `限制：${brand.coupon.limits.join('、')}。` : ''}${brand.coupon.usage}。`
      : '资料未提供优惠码。',
  },
  {
    q: `${brand.displayName}有实测数据吗？`,
    a: tested
      ? `有。目前共 ${reports.length} 份记录，证据等级为“${evidenceText}”${brand.speedTests.latestDatedTest ? `，最近一次有日期的测试为 ${brand.speedTests.latestDatedTest}` : ''}。每份报告都注明工具、出口与局限，详见本页“测速与证据”。`
      : `暂无。${brand.peakTestNote ?? '资料未提供测速记录。'}本站不会用其他品牌或他人的数据替代，补充实测后会更新。`,
  },
  {
    q: `${brand.displayName}多少钱？最低多少一个月？`,
    a: entry
      ? `资料显示入门档为 ${entry.planName}：${formatPrice(entry.price)}/月，${formatTraffic(entry.trafficGB)}/月，折合 ${formatPerGB(entry.pricePerGB)}（不含优惠码）。其余档位与年付、不限时流量包见本页套餐表，实付以结算页为准。`
      : '资料未提供可比较的月付周期套餐价格。',
  },
];

const crumbs = [
  { name: '首页', href: '/' },
  { name: '品牌评测', href: '/reviews/' },
  { name: brand.displayName, href: `/reviews/${brand.slug}/` },
];
const jsonLd = [
  articleLd({
    type: 'Article',
    headline: `${brand.displayName}机场资料与测评（2026 年度版）`,
    description,
    url: `/reviews/${brand.slug}/`,
    datePublished: '2026-11-10',
    dateModified: brand.lastVerifiedAt ?? '2026-11-10',
    keywords: brand.keywords,
    section: '品牌评测',
  }),
  breadcrumbLd(crumbs),
  faqLd(faq),
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime="2026-11-10"
  modifiedTime={brand.lastVerifiedAt ?? undefined}
>
  <div class="container">
    <Breadcrumbs crumbs={crumbs} />

    <header class="brand-hero card">
      <div class="bh-main">
        <BrandMark brand={brand} size={72} />
        <div class="bh-text">
          <h1>
            {brand.displayName}
            {brand.englishName && <span class="bh-en">{brand.englishName}</span>}
          </h1>
          <p class="bh-tagline">{brand.tagline}</p>
          <div class="bh-badges">
            <EvidenceBadge brand={brand} />
            <span class="badge badge-medium">榜单第 {ranked.position} 位（编辑整理）</span>
            <span class="badge badge-none">资料核实 {brand.lastVerifiedAt}</span>
            <span class={`badge ${tested ? 'badge-strong' : 'badge-weak'}`}>{tested ? '已有测试记录' : '未测试'}</span>
            <FavButton url={`/reviews/${brand.slug}/`} title={`${brand.displayName} 品牌资料与测评`} type="品牌测评" class="bh-fav" />
          </div>
          {
            brand.intro && (
              <div class="bh-intro">
                <p class="bh-intro-heading">{brand.intro.heading}</p>
                {brand.intro.slogan && <p class="bh-intro-slogan">{brand.intro.slogan}</p>}
                {brand.intro.paragraphs.map((p) => (
                  <p class="bh-intro-p">{p}</p>
                ))}
                {brand.intro.tagline && <p class="bh-intro-tagline">{brand.intro.tagline}</p>}
                {brand.intro.source && <p class="bh-intro-source small muted">{brand.intro.source}</p>}
              </div>
            )
          }
          <ReadTracker type="品牌测评" title={`${brand.displayName} 品牌资料与测评`} url={`/reviews/${brand.slug}/`} />
        </div>
      </div>
      <div class="bh-side">
        {
          entry ? (
            <div class="bh-price">
              <span class="muted small">入门档 · {entry.planName}</span>
              <strong>
                {formatPrice(entry.price)}
                <small>/月</small>
              </strong>
              <span class="small">
                {formatTraffic(entry.trafficGB)}/月 · {formatPerGB(entry.pricePerGB)}
              </span>
            </div>
          ) : (
            <div class="bh-price">
              <span class="muted small">入门价格</span>
              <strong>资料未提供</strong>
            </div>
          )
        }
        <div class="bh-actions">
          {
            brand.affiliateUrl && (
              <a class="btn btn-primary" href={brand.affiliateUrl} rel="sponsored nofollow noopener noreferrer" target="_blank">
                前往官网 / 推广入口
                <Icon name="external" size={16} />
              </a>
            )
          }
          <a class="btn btn-outline" href="/compare/">与其他品牌对比</a>
        </div>
        <p class="bh-disclosure small muted">
          <Icon name="info" size={14} />
          以上为推广链接，购买可能为本站带来佣金；排序与评语不受影响。<a href="/disclosure/">披露说明</a>
        </p>
      </div>
    </header>

    <div class="brand-layout">
      <div class="brand-content">
        <section class="card" id="overview" aria-labelledby="overview-title">
          <h2 id="overview-title" class="section-title"><Icon name="info" size={20} />品牌概览</h2>
          <p>{brand.description}</p>
          <dl class="facts">
            <div><dt>节点地区</dt><dd>{brand.nodeRegions.join('、')}（{brand.nodeRegions.length} 个）</dd></div>
            <div><dt>节点数</dt><dd>{brand.nodeCount ?? '资料未提供'}{brand.nodeCountNote && <span class="muted small"> · {brand.nodeCountNote}</span>}</dd></div>
            <div><dt>线路类型</dt><dd>{brand.lineTypes.join('；')}</dd></div>
            <div><dt>协议</dt><dd>{brand.protocol ?? '资料未提供'}</dd></div>
            <div><dt>倍率</dt><dd>{brand.ratio ?? '资料未提供'}</dd></div>
            <div><dt>设备数</dt><dd>{brand.deviceLimit}</dd></div>
            <div><dt>支持系统</dt><dd>{brand.supportedPlatforms.length ? brand.supportedPlatforms.join('、') : '资料未逐一列出'}{brand.platformsNote && <span class="muted small"> · {brand.platformsNote}</span>}</dd></div>
            <div><dt>官网</dt><dd>{brand.officialWebsite ? <a href={brand.officialWebsite} rel="nofollow noopener noreferrer" target="_blank">{brand.officialWebsite}</a> : '资料仅提供推广入口'}</dd></div>
          </dl>
          {
            Object.keys(brand.nodeCountByRegion).length > 0 && (
              <div class="table-wrap">
                <table class="data">
                  <caption class="visually-hidden">各地区节点数（资料）</caption>
                  <thead>
                    <tr>
                      {Object.keys(brand.nodeCountByRegion).map((r) => (
                        <th>{r}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      {Object.values(brand.nodeCountByRegion).map((n) => (
                        <td>{n === null ? '待确认' : `${n} 个`}</td>
                      ))}
                    </tr>
                  </tbody>
                </table>
              </div>
            )
          }
          {
            (brand.mission || brand.slogan) && (
              <details class="brand-self">
                <summary>品牌自述（使命 / 愿景 / 价值观 / 口号，来自资料原文）</summary>
                <ul class="small">
                  {brand.slogan && <li>口号：{brand.slogan}</li>}
                  {brand.mission && <li>使命：{brand.mission}</li>}
                  {brand.vision && <li>愿景：{brand.vision}</li>}
                  {brand.values && <li>价值观：{brand.values}</li>}
                </ul>
              </details>
            )
          }
        </section>

        <section class="card" id="features" aria-labelledby="features-title">
          <h2 id="features-title" class="section-title"><Icon name="sparkle" size={20} />资料所述主要特点</h2>
          {brand.serviceFeatures.length ? <ul class="feature-list">{brand.serviceFeatures.map((f) => <li><Icon name="check" size={16} />{f}</li>)}</ul> : <p class="empty">资料未列出</p>}
          <h3>资料所述适合人群</h3>
          {brand.audiences.length ? <ul class="audience-list">{brand.audiences.map((a) => <li>{a}</li>)}</ul> : <p class="muted small">资料未列出具体适合人群。</p>}
          <p class="small muted">以上为品牌/推广方资料中的表述，本站未对“适合人群”做独立验证；是否适合你，请结合下方实测证据与自己的使用场景判断。</p>
        </section>

        <section class="card" id="plans" aria-labelledby="plans-title">
          <h2 id="plans-title" class="section-title"><Icon name="tag" size={20} />套餐与价格</h2>
          <PlanTable brandId={brand.id} />
          {
            brand.coupon && (
              <div class="coupon-box">
                <Icon name="tag" size={18} />
                <div>
                  <strong>优惠码 {brand.coupon.code}</strong>
                  <span>{brand.coupon.discount ?? '折扣幅度资料未注明'}</span>
                  <ul class="small">
                    {brand.coupon.appliesTo.length > 0 && <li>适用：{brand.coupon.appliesTo.join('、')}</li>}
                    {brand.coupon.excludes.length > 0 && <li>不适用：{brand.coupon.excludes.join('、')}</li>}
                    {brand.coupon.limits.length > 0 && <li>限制：{brand.coupon.limits.join('、')}</li>}
                    <li>{brand.coupon.usage}</li>
                  </ul>
                </div>
              </div>
            )
          }
          <h3>流量规则</h3>
          <ul class="small">{brand.trafficRules.map((r) => <li>{r}</li>)}</ul>
        </section>

        <section class="card" id="clients" aria-labelledby="clients-title">
          <h2 id="clients-title" class="section-title"><Icon name="device" size={20} />设备与客户端政策</h2>
          <dl class="facts">
            <div><dt>使用方式</dt><dd>{brand.clientPolicy.officialClient ? '官方客户端，账号登录即可连接' : '资料未说明'}</dd></div>
            <div><dt>订阅链接</dt><dd>{brand.clientPolicy.subscriptionLink}</dd></div>
            <div><dt>第三方客户端</dt><dd>{brand.clientPolicy.thirdPartyClients}</dd></div>
            <div><dt>下载渠道</dt><dd>{brand.clientPolicy.downloadChannel}</dd></div>
            {brand.clientPolicy.note && <div><dt>说明</dt><dd>{brand.clientPolicy.note}</dd></div>}
          </dl>
          {
            brand.clientPolicy.platformsDetail && (
              <>
                <h3>按系统的客户端说明</h3>
                <div class="table-wrap">
                  <table class="data">
                    <thead>
                      <tr><th>系统</th><th>客户端</th><th>状态</th><th>资料来源</th></tr>
                    </thead>
                    <tbody>
                      {brand.clientPolicy.platformsDetail.map((p) => (
                        <tr>
                          <td class="nowrap">{p.platforms}</td>
                          <td>{p.client}</td>
                          <td class="nowrap">
                            <span class={`badge ${p.kind === 'brand' ? 'badge-medium' : p.kind === 'third' ? 'badge-strong' : 'badge-none'}`}>
                              {p.kind === 'brand' ? '品牌客户端' : p.kind === 'third' ? '第三方客户端' : '待核实'}
                            </span>
                          </td>
                          <td class="small">{p.source}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="small muted">“待核实”表示本站没有可靠依据判断兼容性，既不标记为已支持，也不标记为不支持；核实后会更新并记录在更新日志。</p>
              </>
            )
          }
          <p class="small muted">想了解官方客户端与 Clash 等第三方客户端的区别，可阅读<a href="/tutorials/clash-verge-rev-jiaocheng/">Clash Verge Rev 教程</a>与<a href="/wiki/tun-moshi-yu-quanju-daili/">TUN 模式与全局代理</a>。</p>
        </section>

        <section class="card" id="streaming" aria-labelledby="streaming-title">
          <h2 id="streaming-title" class="section-title"><Icon name="play" size={20} />流媒体与 AI 工具（资料所述）</h2>
          <div class="two-col">
            <div>
              <h3>流媒体</h3>
              {brand.streamingSupport.length ? <ul class="tag-list">{brand.streamingSupport.map((s) => <li class="tag">{s}</li>)}</ul> : <p class="muted small">资料未列出</p>}
            </div>
            <div>
              <h3>AI 工具</h3>
              {brand.aiSupport.length ? <ul class="tag-list">{brand.aiSupport.map((s) => <li class="tag">{s}</li>)}</ul> : <p class="muted small">资料未列出</p>}
            </div>
          </div>
          {brand.streamingNote && <p class="small muted">{brand.streamingNote}</p>}
          {
            ownerReport?.ownerReport && (
              <p class="small">
                站长 {brand.speedTests.latestDatedTest} 的实测中，IPCheck.ing 连通性测试 {ownerReport.ownerReport.connectivityTotal} 项全部显示可用（{ownerReport.ownerReport.connectivity.slice(0, 6).map((c) => c.name).join('、')} 等），详见下方报告。
              </p>
            )
          }
        </section>

        <section class="card" id="speed" aria-labelledby="speed-title">
          <h2 id="speed-title" class="section-title"><Icon name="speed" size={20} />测速与证据</h2>
          {
            reports.length ? (
              <>
                <p class="small muted">证据等级：{evidenceText}。每份记录都注明来源、工具、时间与局限；不同时间、节点与网络环境的结果不能直接对比。</p>
                {reportImage && ownerReport && (
                  <figure class="report-figure">
                    <a href={reportImage.src} target="_blank" rel="noopener">
                      <Image src={reportImage} alt={`${ownerReport.title}：站长根据实测截图整理的报告图`} widths={[640, 960, 1280]} sizes="(max-width: 960px) 100vw, 880px" loading="lazy" decoding="async" />
                    </a>
                    <figcaption class="small muted">{ownerReport.evidenceFiles[0]?.caption}。点击图片在新标签页查看大图。</figcaption>
                  </figure>
                )}
                <div class="report-grid">
                  {reports.map((r) => (
                    <ReportCard report={r} />
                  ))}
                </div>
              </>
            ) : (
              <div class="empty">
                <p><strong>暂无可验证测速记录</strong></p>
                <p class="small">{brand.peakTestNote ?? '资料未提供测速数据。'}本站不会用虚构数据或其他品牌的数据填充。</p>
              </div>
            )
          }
        </section>

        <section class="card" id="support" aria-labelledby="support-title">
          <h2 id="support-title" class="section-title"><Icon name="shield" size={20} />客服、退款与防骗</h2>
          <dl class="facts">
            <div><dt>客服渠道</dt><dd>{brand.support.channels.length ? brand.support.channels.join('；') : '资料未提供'}</dd></div>
            <div><dt>客服时间</dt><dd>{brand.support.hours ?? '资料未说明'}</dd></div>
            <div><dt>退款</dt><dd>{brand.support.refund ?? '资料未说明'}</dd></div>
            <div><dt>试用</dt><dd>{brand.support.trial ?? '资料未说明'}</dd></div>
            <div><dt>付款方式</dt><dd>{brand.support.payment ?? '资料未说明'}</dd></div>
            <div><dt>防骗提醒</dt><dd>{brand.support.antiFraud ?? '资料未提供'}</dd></div>
          </dl>
          <h3>资料所述购买流程</h3>
          <ol class="small">{brand.purchaseSteps.map((s) => <li>{s}</li>)}</ol>
        </section>

        <section class="card" id="sources" aria-labelledby="sources-title">
          <h2 id="sources-title" class="section-title"><Icon name="file" size={20} />资料来源与核实</h2>
          <div class="table-wrap">
            <table class="data">
              <thead>
                <tr><th>来源文件</th><th>类型</th><th>整理日期</th><th>可信度说明</th></tr>
              </thead>
              <tbody>
                {sources.map((s) => (
                  <tr>
                    <td class="mono small">{s.file.replace('source-materials/', '')}</td>
                    <td class="small">{s.sourceType === 'user-supplied-official' ? '品牌/推广方资料' : s.sourceType === 'independently-measured' ? '站长实测报告' : s.sourceType === 'user-supplied-screenshot' ? '用户提供截图' : s.sourceType}</td>
                    <td class="nowrap">{s.collectedAt}</td>
                    <td class="small">{s.credibility}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {
            brand.dataCaveats.length > 0 && (
              <div class="callout callout-warn">
                <Icon name="warn" size={18} />
                <div>
                  <strong>整理时发现的待确认事项</strong>
                  <ul class="small" style="margin:6px 0 0">
                    {brand.dataCaveats.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </div>
            )
          }
          <p class="small muted">发现资料与官网不一致？请通过<a href="/contact/">联系与纠错</a>页面反馈，我们会在核实后更正并记录在<a href="/news/#changelog">更新日志</a>。</p>
        </section>

        <FAQ items={faq} title={`关于${brand.displayName}的常见问题`} id="brand-faq" />
      </div>

      <aside class="brand-aside">
        <nav class="card toc" aria-label="本页目录">
          <h2 class="toc-title">本页目录</h2>
          <ol>
            <li><a href="#overview">品牌概览</a></li>
            <li><a href="#features">主要特点与人群</a></li>
            <li><a href="#plans">套餐与价格</a></li>
            <li><a href="#clients">设备与客户端</a></li>
            <li><a href="#streaming">流媒体与 AI</a></li>
            <li><a href="#speed">测速与证据</a></li>
            <li><a href="#support">客服与防骗</a></li>
            <li><a href="#sources">资料来源</a></li>
            <li><a href="#brand-faq">常见问题</a></li>
          </ol>
        </nav>
        <div class="card">
          <h2 class="toc-title">榜单位置</h2>
